  "exhibitionAdditions": [
    {
      "slug": "neoclassical/briseis-achilles-thorvaldsen-freund-a489",
      "text": "Modeled 1803; this marble executed in 1865 by Georg Christian Freund after Thorvaldsen. Agamemnon’s heralds lead Briseis away from Achilles. The hero’s anger fills the Iliad, but Briseis’s captivity makes the conflict possible: military success allows commanders to treat a person as a prize. Compare this scene with Bissen’s Wrathful Achilles, shifting attention from the hero’s wounded pride to the woman whose freedom neither commander recognizes."
    },
    {
      "slug": "neoclassical/priam-achilles-thorvaldsen-freund-a775",
      "text": "Modeled 1815; marble executed in 1868–1870 by Georg Christian Freund after Thorvaldsen. Priam kneels before the man who killed his son, asking for the return of Hector’s body. The victorious Achilles must decide how to answer the defeated father. War’s aftermath becomes a plea to bury the dead; humility and mercy interrupt the language of heroic glory."
    },
    {
      "slug": "neoclassical/hector-andromache-thorvaldsen-bissen-a776",
      "text": "Modeled 1837; marble executed in 1867–1870 by H. W. Bissen after Thorvaldsen. Hector takes leave of Andromache and their son Astyanax before returning to battle. The family’s gestures hold a private farewell inside the public demands of war. Set beside Priam’s plea, the scene lets us see the future grief already present in the hero’s duty to fight."
    }
  ],
