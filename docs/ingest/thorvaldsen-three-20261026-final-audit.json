    {
      "path": "/wallTexts/power-and-presence/captions",
      "appendOnly": true,
      "added": [
        {
          "slug": "neoclassical/thorvaldsen-cupid-earth-marble-relief-5dcf93",
          "text": "A small Cupid rests his hand on a lion and carries Hercules’s club. The contrast in scale gives the allegory its force: love claims power over physical strength. This posthumous marble follows Thorvaldsen’s 1828 composition, with Georg Christian Freund credited as assistant."
        },
        {
          "slug": "neoclassical/thorvaldsen-cupid-underworld-marble-relief-35ee39",
          "text": "Cupid holds the underworld’s staff beside Cerberus, its multi-headed guardian. Borrowed emblems turn the child into a ruler of the realm of the dead. This posthumous marble follows Thorvaldsen’s 1828 composition; the execution assistant remains unidentified."
        },
        {
          "slug": "neoclassical/thorvaldsen-cupid-heaven-marble-relief-1edac3",
          "text": "Riding the eagle and raising a thunderbolt, Cupid takes up Jupiter’s emblems. The familiar signs of divine authority are placed in a child’s hands, extending the sequence’s claim that love rules every realm."
        }
      ]
    }
  ],
