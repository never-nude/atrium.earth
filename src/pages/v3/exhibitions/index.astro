---
import V3Layout from '../../../layouts/v3/V3Layout.astro';
import { exhibitions, featuredWork, v3ExhibitionRoute } from '../../../lib/v3';
import { withBase } from '../../../lib/urls';
---

<V3Layout
  title="Exhibitions"
  description="Narrated routes through the Atrium.Earth sculpture collection."
  image={featuredWork.thumbnailImage}
>
  <header class="v3-page-hero">
    <p class="v3-kicker">Curated rooms / {String(exhibitions.length).padStart(2, '0')}</p>
    <h1 class="v3-display">Not categories.<br /><em>Arguments.</em></h1>
    <p>Each exhibition is a walked route: numbered stops, wall text, a way out. Take one in order, or use any stop as a door into the wider museum.</p>
  </header>

  <section class="v3-exlist" style="margin: 0 var(--v3-pad) 140px;" aria-label="Current exhibitions">
    {exhibitions.map((exhibition) => (
      <a class="v3-exrow" href={withBase(v3ExhibitionRoute(exhibition))} style={`--ex-accent:${exhibition.accent}`}>
        <span class="v3-exrow__no">{exhibition.number}</span>
        <div>
          <p class="v3-exrow__kicker">{exhibition.kicker}</p>
          <h3>{exhibition.title}</h3>
        </div>
        <p class="v3-exrow__summary">{exhibition.summary}</p>
        <span class="v3-exrow__img v3-float"><img src={withBase(exhibition.works[0].thumbnailImage)} alt="" width="240" height="300" loading="lazy" decoding="async" /></span>
        <b aria-hidden="true">↗</b>
      </a>
    ))}
  </section>
</V3Layout>
