---
import Viewer from '../../components/Viewer.astro';
import DimensionValue from '../../components/DimensionValue.astro';
import V3WorkCard from '../../components/v3/V3WorkCard.astro';
import V3Layout from '../../layouts/v3/V3Layout.astro';
import { workBySlug, works, type Work } from '../../lib/catalog';
import { exhibitions, neighborsFor, v3ExhibitionRoute, v3WorkRoute } from '../../lib/v3';
import { withBase } from '../../lib/urls';
import { museumLabelFor } from '../../lib/museum-label.mjs';
import visitsData from '../../data/curated-visits.json';
import { worldPayloadUrl } from '../../lib/world-payload';
import { modelSizeLabel } from '../../lib/viewer-preview.mjs';

export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

type Props = { work: Work };
const { work } = Astro.props;
const fullDetailPath = work.hasFirstView ? withBase(`/detail/${work.slug}/`) : '';
const inlineSpatialViewing = !work.hasFirstView && work.spatialAccess.enabled;
const socialImage = `/previews/renders/${work.slug}/thumb.jpg`;
const { previous, next } = neighborsFor(work);
const related = work.relatedWorks.map((slug) => workBySlug(slug)).filter((candidate): candidate is Work => Boolean(candidate)).slice(0, 6);
const rooms = exhibitions.filter((exhibition) => exhibition.works.some((candidate) => candidate.slug === work.slug));
const journeyData = {
  slug:work.slug, base:withBase('/'), worldDataUrl:worldPayloadUrl,
  exhibitions:rooms.map(room=>({slug:room.slug,title:room.title,works:room.works.map((item,index)=>({slug:item.slug,title:item.title,anchor:room.comparisons?.length ? `#pair-${room.comparisons.findIndex(pair=>pair.works.some(candidate=>candidate.slug===item.slug))+1}` : `#stop-${index+1}`}))})),
  visits:Object.entries(visitsData.visits).filter(([,visit])=>visit.stops.some(stop=>stop.workSlug===work.slug))
    .map(([exhibition,visit])=>({exhibition,id:visit.id,title:visit.title,stops:visit.stops.map(stop=>({workSlug:stop.workSlug,title:workBySlug(stop.workSlug)?.title || stop.title}))})),
};
const originalLocation = work.originalLocation && work.originalLocation.toLowerCase() !== work.museum.toLowerCase()
  ? work.originalLocation
  : '';
const facts = ([
  ['Maker', work.maker],
  ['Date', work.displayDate],
  ['Origin', originalLocation],
  ['Material', work.medium],
  ['Dimensions', work.dimensions || (work.dimensionsNote ? 'Not yet verified' : '')],
  ['Location / collection', work.museum],
  ['Department', work.department],
  ['Accession / inventory', work.accession],
] as Array<[string, string]>).filter(([, value]) => Boolean(value && !/not yet recorded|unassigned/i.test(value)));
const sourceLabel = work.sourceMuseum || (work.sourceUrl ? new URL(work.sourceUrl).hostname.replace(/^www\./, '') : '');
---

<V3Layout
  title={work.title}
  description={`${work.title}${work.maker ? ` by ${work.maker}` : ''}. Explore the sculpture in 3D.`}
  image={socialImage}
  immersive={true}
>
  <nav class="work-journey" data-work-journey aria-label="Your visit" hidden>
    <p data-journey-label></p><a data-journey-return href={withBase('/exhibitions/')}>Return to exhibition →</a>
  </nav>
  <script type="application/json" data-work-journey-data set:html={JSON.stringify(journeyData).replace(/</g,'\\u003c')} />
  <script>import '../../scripts/work-journey.js';</script>
  <section id="sculpture" class="v3-object-stage" aria-labelledby="v3-object-title" tabindex="-1" style={`view-transition-name: w-${work.id};`}>
    <Viewer
      glb={withBase(work.modelGlb)}
      modelBytes={work.modelBytes}
      poster={withBase(work.thumbnailImage)}
      title={work.title}
      hud={false}
      immersive={true}
      loadingPlacement="below"
      displayControls={true}
      spatialViewing={inlineSpatialViewing}
      museumLabel={museumLabelFor(work)}
      spatialAssetSha256={work.spatialAccess.assetSha256}
      spatialDimensionStatus={work.spatialAccess.status}
      spatialLabel={work.spatialAccess.label}
      spatialSizeLabel={work.spatialAccess.sizeLabel}
      spatialDefaultMaxExtentMeters={work.spatialAccess.defaultMaxExtentMeters}
      spatialUnavailableNote={work.spatialAccess.enabled ? undefined : work.spatialAccess.note}
      spatialReference={work.spatialAccess.reference}
      displaySupport={work.displaySupport}
      spatialNote={work.spatialAccess.verified ? `${work.spatialAccess.sizeLabel}. ${work.spatialNote}` : work.spatialAccess.note}
      posterLoading="eager"
      upAxis={work.modelUpAxis}
      modelTransform={work.modelTransform}
      materialAppearance={work.materialAppearance}
    />

    <div class="v3-object-title">
      <div class="work-title-line">
        <h1 id="v3-object-title">{work.title}</h1>
        <div data-work-save-slot></div>
      </div>
      <p>{[work.maker, work.displayDate].filter(Boolean).join(' · ')}</p>
    </div>

    {fullDetailPath && <div class="v3-object-actions">
      <div class="work-record-actions">
        <a class="v3-object-record-link" data-full-detail href={fullDetailPath}>Full detail · {modelSizeLabel(work.originalBytes)} <span aria-hidden="true">↗</span></a>
        {work.spatialAccess.enabled && (
          <a id="ar-vr" class="v3-object-record-link" href={`${fullDetailPath}#ar-vr`}>AR / VR <span aria-hidden="true">↗</span></a>
        )}
      </div>
    </div>}
  </section>

  <script>
    // The interface recedes while the visitor handles the sculpture (see .is-engaged in v3.css).
    const stageSection = document.querySelector('.v3-object-stage');
    const canvasHost = stageSection?.querySelector('.model-stage');
    const viewerRoot = stageSection?.querySelector('.viewer');
    if (viewerRoot && canvasHost) {
      const controls = viewerRoot.querySelectorAll('[data-immersive-tools], [data-display-controls], [data-spatial], [data-spatial-unavailable]');
      if (controls.length) {
        const controlsRow = document.createElement('div');
        controlsRow.className = 'v3-object-viewer-controls';
        const start = viewerRoot.querySelector('.viewer-start');
        (start ?? canvasHost).after(controlsRow);
        controlsRow.append(...controls);
        const tools = viewerRoot.querySelector('[data-immersive-tools]');
        const display = viewerRoot.querySelector('[data-display-controls]');
        const fullscreen = tools?.querySelector('[data-tool-fullscreen]');
        if (tools && fullscreen) {
          const settings = document.createElement('details');
          settings.className = 'work-viewer-settings';
          const summary = document.createElement('summary');
          summary.textContent = '3D settings';
          const panel = document.createElement('div');
          panel.className = 'work-settings-panel';
          panel.append(...Array.from(tools.children).filter(control => control !== fullscreen));
          if (display) panel.append(display);
          settings.append(summary, panel);
          tools.append(settings);
        }
      }
    }
    const revealRecord = () => {
      if (!['#object-record', '#size-verification'].includes(location.hash)) return;
      const record = document.querySelector<HTMLDetailsElement>('#object-record');
      if (record) record.open = true;
    };
    revealRecord();
    window.addEventListener('hashchange', revealRecord);
    let quietTimer = 0;
    if (stageSection && canvasHost) {
      // Track live pointers by id so a pinch (two fingers) stays engaged until the
      // LAST finger lifts, and so toolbar taps (whose downs we never counted) are ignored.
      const activePointers = new Set<number>();
      const scheduleRelease = () => {
        window.clearTimeout(quietTimer);
        quietTimer = window.setTimeout(() => stageSection.classList.remove('is-engaged'), 900);
      };
      canvasHost.addEventListener('pointerdown', (event) => {
        // Only handling the sculpture engages: the WebGL canvas itself, not the
        // toolbar/activate buttons that also live inside .model-stage.
        if (!(event.target instanceof Element) || !event.target.classList.contains('viewer-canvas')) return;
        activePointers.add(event.pointerId);
        window.clearTimeout(quietTimer);
        stageSection.classList.add('is-engaged');
      });
      const releasePointer = (event: PointerEvent) => {
        if (!activePointers.delete(event.pointerId)) return;
        if (activePointers.size === 0) scheduleRelease();
      };
      // pointercancel (interrupted touch) and blur (focus lost mid-drag) can eat the
      // pointerup; treat all of them as "the visitor let go" so the title always returns.
      window.addEventListener('pointerup', releasePointer);
      window.addEventListener('pointercancel', releasePointer);
      window.addEventListener('blur', () => { activePointers.clear(); scheduleRelease(); });
    }
  </script>

  <details id="object-record" class="work-disclosure">
    <summary>Details &amp; sources</summary>
    <dl class="v3-facts">
      <div id="size-verification" tabindex="-1"><dt>AR / VR</dt><dd><strong class="v3-dimension-status" data-dimension-status={work.spatialAccess.status}>{work.spatialAccess.label}{work.spatialAccess.enabled && ` · ${work.spatialAccess.sizeLabel}`}</strong>. {work.spatialAccess.note}{work.spatialAccess.status === 'approximate' && work.spatialAccess.sourceText && <small class="v3-estimate-evidence">Listed dimensions / description: {work.spatialAccess.sourceText}{work.spatialAccess.sourceUrl && <> <a href={work.spatialAccess.sourceUrl}>Source ↗</a></>}</small>}</dd></div>
      {facts.map(([label, value]) => <div><dt>{label}</dt><dd>{label === 'Dimensions'
        ? <DimensionValue value={work.dimensions} note={work.dimensionsNote} sourceUrl={work.dimensionsSourceUrl} />
        : value}</dd></div>)}
      {work.sourceRecordUrl && <div><dt>Museum record</dt><dd><a href={work.sourceRecordUrl}>Collection record ↗</a></dd></div>}
      {work.relatedSourceRecordUrls.filter((url) => url !== work.sourceRecordUrl).map((url, index) => (
        <div><dt>Additional record</dt><dd><a href={url}>Collection record {index + 2} ↗</a></dd></div>
      ))}
      {work.sourceUrl && <div><dt>3D source</dt><dd><a href={work.sourceUrl}>{sourceLabel} ↗</a></dd></div>}
      {work.scanSource && <div><dt>Model / capture</dt><dd>{work.scanSource}</dd></div>}
      {work.scanAuthor && <div><dt>Captured by</dt><dd>{work.scanAuthor}</dd></div>}
      {work.creditLine && <div><dt>Credit</dt><dd>{work.creditLine}</dd></div>}
      {work.rights && !/review pending/i.test(work.rights) && (
        <div>
          <dt>Rights</dt>
          <dd>{work.licenseUrl ? <a href={work.licenseUrl} rel="license">3D scan: {work.rights} ↗</a> : work.rights}</dd>
        </div>
      )}
      {work.aiTrainingRestricted && <div><dt>AI use</dt><dd>Source marked NoAI</dd></div>}
    </dl>
  </details>

  {rooms.length > 0 && (
    <section class="v3-object-rooms" aria-labelledby="rooms-title">
      <p class="v3-kicker">Related exhibitions</p>
      <h2 id="rooms-title" class="v3-display">This work appears in</h2>
      {rooms.map((room) => <a href={withBase(v3ExhibitionRoute(room))} style={`--ex-accent:${room.accent}`}><span>{room.number}</span><strong>{room.title}</strong><i>View exhibition ↗</i></a>)}
    </section>
  )}

  {related.length > 0 && (
    <section class="v3-object-related" aria-labelledby="related-title">
      <div class="v3-section-head v3-section-head--split">
        <div><p class="v3-kicker">Related works</p><h2 id="related-title" class="v3-display">Continue exploring the collection.</h2></div>
      </div>
      <div class="v3-rail">{related.map((candidate) => <V3WorkCard work={candidate} />)}</div>
    </section>
  )}
  <nav class="v3-object-nav work-bottom-nav" aria-label="Previous and next sculptures">
    <a data-work-previous href={withBase(v3WorkRoute(previous))} aria-label={`Previous work: ${previous.title}`}><span>←</span><i>{previous.title}</i></a>
    <a data-work-next href={withBase(v3WorkRoute(next))} aria-label={`Next work: ${next.title}`}><i>{next.title}</i><span>→</span></a>
  </nav>
</V3Layout>

<style>
  .work-title-line { display: flex; align-items: start; justify-content: space-between; gap: 12px; }
  .work-title-line h1 { min-width: 0; overflow-wrap: anywhere; }
  .work-title-line [data-work-save-slot] { flex: none; }
  .work-title-line :global(.studio-save--object) { position: static; margin: 0; }
  .work-disclosure { margin: 0 var(--v3-pad); border-top: 1px solid var(--v3-line); scroll-margin-top: 88px; }
  .work-disclosure > summary { display: flex; align-items: center; justify-content: space-between; min-height: 56px; cursor: pointer; font-weight: 600; list-style: none; }
  .work-disclosure > summary::-webkit-details-marker { display: none; }
  .work-disclosure > summary::after { content: '+'; }
  .work-disclosure[open] > summary::after { content: '−'; }
  .v3-object-nav.work-bottom-nav { position: static; margin: 24px var(--v3-pad); gap: 12px; }
  .work-bottom-nav a { min-width: 0; min-height: 44px; }
  .work-bottom-nav i, .work-bottom-nav a:hover i { display: block; max-width: 22ch; opacity: 1; }
  .v3-object-stage :global(.work-viewer-settings) { position: relative; }
  .v3-object-stage :global(.work-viewer-settings > summary) { display: flex; align-items: center; min-height: 44px; padding: 0 10px; cursor: pointer; color: var(--v3-muted); font-size: 12px; }
  .v3-object-stage :global(.work-settings-panel) { position: absolute; z-index: 35; bottom: calc(100% + 6px); left: 0; min-width: 164px; display: grid; padding: 6px; border: 1px solid var(--v3-line); border-radius: 8px; background: var(--v3-void); }
  .v3-object-stage :global(.work-settings-panel .immersive-light__panel) { position: static; width: min(235px, 52vw); }
  .v3-object-stage :global(.spatial-dimension-badge) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .work-record-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .work-record-actions #ar-vr { scroll-margin-top: 88px; }
  .work-journey { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px 24px; padding: 12px var(--v3-pad); border-bottom: 1px solid var(--v3-line); background: var(--v3-well); }
  .work-journey[hidden], .v3-object-nav a[hidden] { display: none; }
  .work-journey p { margin: 0; color: var(--v3-muted); font-size: 12px; }
  .work-journey a { display: inline-flex; align-items: center; min-height: 44px; color: var(--v3-signal); font-size: 12px; text-underline-offset: 4px; }
  .v3-estimate-evidence { display: block; margin-top: 8px; font-size: 12px; line-height: 1.6; color: var(--v3-muted); }
  .v3-object-stage :global(.viewer:is(:fullscreen, [data-viewer-expanded]) > .v3-object-viewer-controls) { position: fixed; inset: auto 12px max(36px, env(safe-area-inset-bottom)) 12px; z-index: 20; flex-wrap: wrap; justify-content: center; gap: 0 12px; margin: 0; border: 0; padding: 0; }
  .v3-object-stage :global(.viewer:is(:fullscreen, [data-viewer-expanded]) .v3-object-viewer-controls .immersive-tools:not([hidden])) { position: static !important; flex: 0 0 auto; }
  @media (max-width: 700px) {
    .v3-object-stage :global(.stage-hint) { display: none; }
    .v3-object-stage :global(.immersive-tools button), .v3-object-stage :global(.immersive-light summary) { min-height: 44px; }
    .v3-object-stage :global(.viewer:is(:fullscreen, [data-viewer-expanded]) .work-viewer-settings) { position: static; }
    .v3-object-stage :global(.viewer:is(:fullscreen, [data-viewer-expanded]) .work-settings-panel) { right: 0; left: auto; }
  }
</style>
