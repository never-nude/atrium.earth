---
import ArtworkLabel from '../../components/ArtworkLabel.astro';
import { works } from '../../lib/catalog';
import { artworkLabelFor, quickLookLabelHeight } from '../../lib/spatial-artwork-label.mjs';
export function getStaticPaths() {
  return works.filter(work => work.spatialAccess.enabled).map(work => ({ params: { slug: work.slug }, props: { label: artworkLabelFor(work) } }));
}
const { label } = Astro.props;
const compact = quickLookLabelHeight(label) === 'large';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{label.title} — Artwork label</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class:list={['ar-banner', { compact }]} style={`--banner-height: ${compact ? 161 : 121}px`}><ArtworkLabel label={label} /></body>
</html>
<style>
  :global(html), :global(body) { margin: 0; background: #0e1626; color-scheme: dark; }
  /* Include the banner root so these overrides beat ArtworkLabel's scoped CSS. */
  :global(body.ar-banner .artwork-label) { min-height: var(--banner-height); border-radius: 0; padding: 10px 14px; }
  :global(body.ar-banner .artwork-label-title) { font-size: 16px; }
  :global(body.ar-banner .artwork-label-facts) { display: block; }
  :global(body.ar-banner .artwork-label-facts > div + div::before) { margin: 0 .35em; }
  :global(body.ar-banner.compact .artwork-label-title) { font-size: 14px; line-height: 1.25; }
  :global(body.ar-banner.compact .artwork-label-maker), :global(body.ar-banner.compact .artwork-label-facts) { font-size: 11px; line-height: 1.3; }
  @media(max-width: 350px) { :global(body.ar-banner .artwork-label-title) { font-size: 14px; } }
</style>
