---
import ArtworkLabel from '../../components/ArtworkLabel.astro';
import { works } from '../../lib/catalog';
import { artworkLabelFor } from '../../lib/spatial-artwork-label.mjs';
export function getStaticPaths() {
  return works.filter(work => work.spatialAccess.enabled).map(work => ({ params: { slug: work.slug }, props: { label: artworkLabelFor(work) } }));
}
const { label } = Astro.props;
const compact = Object.values(label).join(' ').length > 190;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{label.title} — Artwork label</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body class:list={{ compact }}><ArtworkLabel label={label} /></body>
</html>
<style>
  :global(html), :global(body) { margin: 0; background: #0e1626; color-scheme: dark; }
  :global(.artwork-label) { min-height: 161px; border-radius: 0; padding: 12px 16px; }
  :global(.artwork-label-title) { font-size: 16px; }
  :global(.compact .artwork-label) { padding: 10px 14px; }
  :global(.compact .artwork-label-title) { font-size: 14px; line-height: 1.25; }
  :global(.compact .artwork-label-maker), :global(.compact .artwork-label-facts) { font-size: 11px; line-height: 1.3; }
  @media(max-width: 350px) { :global(.artwork-label-title) { font-size: 14px; } }
</style>
