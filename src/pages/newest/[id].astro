---
import { additionBatches } from '../../lib/additions';
import { absoluteUrl, withBase } from '../../lib/urls';
export function getStaticPaths() {
  return additionBatches.map((batch) => ({ params: { id: batch.id } }));
}
const destination = withBase('/newest/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={absoluteUrl('/newest/', import.meta.env.SITE || 'https://atrium.earth')} />
    <title>Newest Additions — Atrium</title>
  </head>
  <body><p><a href={destination}>View the newest additions to Atrium.</a></p></body>
</html>
