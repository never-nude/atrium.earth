---
import V3CollectionExplorer from '../../components/v3/V3CollectionExplorer.astro';
import V3Layout from '../../layouts/v3/V3Layout.astro';
import { works } from '../../lib/catalog';
import ritualLife from '../../../docs/ingest/ritual-life-20260909.json';
import animals from '../../../docs/ingest/animals-20260909.json';
import formsOfDesire from '../../../docs/ingest/intimacy-20260909.json';
import rearViews from '../../../docs/ingest/curves-20260909.json';
import bodyAndDesire from '../../../docs/ingest/eros-20260909.json';
import acrossTimeAndPlace from '../../../docs/ingest/diverse-collection-20260908.json';
import acrossTimeAndPlaceRound2 from '../../../docs/ingest/diverse-round2-20260909.json';
import firstBatch from '../../../research/diverse-collections-20260907.json';
import secondBatch from '../../../research/diverse-collections-round2-20260907.json';
import sculptureBatch from '../../../research/modern-sculpture-round3-20260907.json';
import nextSculptureBatch from '../../../research/modern-sculpture-round4-20260907.json';
import contemporaryVoices from '../../../research/contemporary-voices-round5-20260907.json';
import nextContemporaryVoices from '../../../research/contemporary-voices-round6-20260907.json';

// Local review uses the production cards and object viewer. It emits no route
// in a production build.
export function getStaticPaths() {
  return import.meta.env.DEV ? [
    { params: { batch: 'daily-life-and-ceremony' } },
    { params: { batch: 'animals-real-and-imagined' } },
    { params: { batch: 'forms-of-desire' } },
    { params: { batch: 'rear-views' } },
    { params: { batch: 'body-and-desire' } },
    { params: { batch: 'across-time-and-place' } },
    { params: { batch: 'across-time-and-place-round2' } },
    { params: { batch: 'diverse-collections' } },
    { params: { batch: 'diverse-collections-round2' } },
    { params: { batch: 'modern-sculpture-round3' } },
    { params: { batch: 'modern-sculpture-round4' } },
    { params: { batch: 'contemporary-voices-round5' } },
    { params: { batch: 'contemporary-voices-round6' } },
  ] : [];
}

const isRitualLife = Astro.params.batch === 'daily-life-and-ceremony';
const isAnimals = Astro.params.batch === 'animals-real-and-imagined';
const isFormsOfDesire = Astro.params.batch === 'forms-of-desire';
const isRearViews = Astro.params.batch === 'rear-views';
const isBodyAndDesire = Astro.params.batch === 'body-and-desire';
const isAcrossTimeAndPlaceRound2 = Astro.params.batch === 'across-time-and-place-round2';
const isAcrossTimeAndPlace = isAcrossTimeAndPlaceRound2 || Astro.params.batch === 'across-time-and-place';
const acrossTimeAndPlaceBatch = isAcrossTimeAndPlaceRound2 ? acrossTimeAndPlaceRound2 : acrossTimeAndPlace;
const isNextSculptureBatch = Astro.params.batch === 'modern-sculpture-round4';
const isNextVoicesBatch = Astro.params.batch === 'contemporary-voices-round6';
const isVoicesBatch = isNextVoicesBatch || Astro.params.batch === 'contemporary-voices-round5';
const isSculptureBatch = isNextSculptureBatch || Astro.params.batch === 'modern-sculpture-round3';
const batch = isNextVoicesBatch ? nextContemporaryVoices : isVoicesBatch ? contemporaryVoices : isNextSculptureBatch ? nextSculptureBatch : isSculptureBatch ? sculptureBatch : Astro.params.batch === 'diverse-collections-round2' ? secondBatch : firstBatch;
const batchSlugs = new Set(isRitualLife ? ritualLife.works.map((work) => work.record.slug) : isAnimals ? animals.works.map((work) => work.record.slug) : isFormsOfDesire ? formsOfDesire.works.map((work) => work.record.slug) : isRearViews ? rearViews.works.map((work) => work.record.slug) : isBodyAndDesire ? bodyAndDesire.works.map((work) => work.record.slug) : isAcrossTimeAndPlace ? acrossTimeAndPlaceBatch.works.map((work) => work.record.slug) : batch.works.map((work) => work.slug));
const additions = works.filter((work) => batchSlugs.has(work.slug));
---

<V3Layout title="New acquisitions · local preview" description="Review the latest additions to Atrium.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <header class="v3-page-hero">
    <p class="v3-kicker">Local preview / {additions.length} new works</p>
    <h1 class="v3-display">{isRitualLife ? 'Daily life and ceremony.' : isAnimals ? 'Animals, real and imagined.' : isFormsOfDesire ? 'Forms of desire.' : isRearViews ? 'The other side.' : isBodyAndDesire ? 'Body and desire.' : isAcrossTimeAndPlace ? 'Across time and place.' : isVoicesBatch ? 'More voices in sculpture.' : isSculptureBatch ? 'Large-scale sculpture.' : 'New to Atrium.'}</h1>
    <p>{isRitualLife ? 'Thirty new works shaped by use: musical instruments, writing tools, ceremonial metalwork, carved wood, and painted vessels. Explore the artistry of objects made to be held, heard, and used.' : isAnimals ? 'Thirty new works exploring animals as guardians, companions, and vessels. Discover ancient bronzes, Peruvian ceramics, Japanese netsuke, African masks, and creatures of myth. Select a work to explore it in three dimensions.' : isFormsOfDesire ? 'Thirty new works exploring erotic art through the nude, the embrace, and the sensual curve. Discover kissing lovers, reclining bodies, and interpretations of Venus, from ancient marble to contemporary sculpture.' : isRearViews ? 'Thirty new sculptures with prominent buttocks, from ancient marble figures to modern bronzes and digital sculpture. Each opens from a rear or three-quarter view. Turn a piece to explore it from every angle.' : isBodyAndDesire ? 'Thirty new works exploring the nude, intimacy, and the body: reclining lovers, bathers, divine couples, and carved figures from prehistoric to modern times. Select a work to explore it in three dimensions.' : isAcrossTimeAndPlaceRound2 ? 'Thirty more works across four millennia: Egyptian amulets, Asian devotional sculpture and ceramics, African carvings, American effigy vessels, a Greenland carving, and objects from Kiribati and Papua New Guinea.' : isAcrossTimeAndPlace ? 'Thirty new works spanning prehistoric clay figures, ancient reliefs, Asian devotional sculpture, West African masks, American ceramics and goldwork, European carvings, and Rapa Nui figures.' : isNextVoicesBatch ? 'Nine works by nine artists new to Atrium. Public sculpture, studio work and ceramics from Czechia, Bulgaria, Australia, France and the United Kingdom. Select a piece to explore it in three dimensions.' : isVoicesBatch ? 'Eleven works by thirteen artists new to Atrium. Stone, bronze, ceramics and digital sculpture, with work from Zimbabwe, India, Brazil, New Zealand, France and the United Kingdom. Select a piece to explore it in three dimensions.' : isNextSculptureBatch ? 'Monumental and life-size sculpture from 1976 to 2019, from public spaces and museum collections. Select a work to explore it in three dimensions.' : isSculptureBatch ? 'Sculpture for plazas, gardens and public spaces, from 1958 to 2008. Select a work to explore it in three dimensions.' : 'African, American, Asian, and Oceanian works. Select a piece to explore it in three dimensions.'}</p>
  </header>
  <section class="v3-collection" aria-label="New works">
    <V3CollectionExplorer works={additions} />
  </section>
</V3Layout>
