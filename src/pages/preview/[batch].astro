---
import V3CollectionExplorer from '../../components/v3/V3CollectionExplorer.astro';
import V3Layout from '../../layouts/v3/V3Layout.astro';
import { works } from '../../lib/catalog';
import firstBatch from '../../../research/diverse-collections-20260907.json';
import secondBatch from '../../../research/diverse-collections-round2-20260907.json';
import sculptureBatch from '../../../research/modern-sculpture-round3-20260907.json';

// Local review uses the production cards and object viewer. It emits no route
// in a production build.
export function getStaticPaths() {
  return import.meta.env.DEV ? [
    { params: { batch: 'diverse-collections' } },
    { params: { batch: 'diverse-collections-round2' } },
    { params: { batch: 'modern-sculpture-round3' } },
  ] : [];
}

const isSculptureBatch = Astro.params.batch === 'modern-sculpture-round3';
const batch = isSculptureBatch ? sculptureBatch : Astro.params.batch === 'diverse-collections-round2' ? secondBatch : firstBatch;
const batchSlugs = new Set(batch.works.map((work) => work.slug));
const additions = works.filter((work) => batchSlugs.has(work.slug));
---

<V3Layout title="New acquisitions · local preview" description="Review the latest additions to Atrium.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <header class="v3-page-hero">
    <p class="v3-kicker">Local preview / {additions.length} new works</p>
    <h1 class="v3-display">{isSculptureBatch ? 'Large-scale sculpture.' : 'New to Atrium.'}</h1>
    <p>{isSculptureBatch ? 'Sculpture for plazas, gardens and public spaces, from 1958 to 2008. Select a work to explore it in three dimensions.' : 'African, American, Asian, and Oceanian works. Select a piece to explore it in three dimensions.'}</p>
  </header>
  <section class="v3-collection" aria-label="New works">
    <V3CollectionExplorer works={additions} />
  </section>
</V3Layout>
