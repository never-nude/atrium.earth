---
import Viewer from '../../../components/Viewer.astro';
import V3WorkCard from '../../../components/v3/V3WorkCard.astro';
import V3Layout from '../../../layouts/v3/V3Layout.astro';
import { wings, wingIds } from '../../../data/wings';
import { logWingBuildReport, featuredWorkForWing, wingById, worksForWing, type WingRouteId } from '../../../lib/wings';
import { v3WorkRoute } from '../../../lib/v3';
import { withBase } from '../../../lib/urls';
import { wingAccent } from '../../../data/wing-palettes';
import { legacyWingRoutes, type LegacyWingId } from '../../../data/wing-legacy-routes';

export function getStaticPaths() {
  logWingBuildReport();
  return [...wingIds, 'unfiled', ...Object.keys(legacyWingRoutes)].map((id) => ({ params: { id } }));
}

const id = Astro.params.id!;
const legacy = legacyWingRoutes[id as LegacyWingId];
const wing = wingById(id);
const wingIndex = wing ? wings.findIndex((candidate) => candidate.id === wing.id) : -1;
const wingWorks = legacy ? [] : worksForWing(id as WingRouteId);
const featured = wing ? featuredWorkForWing(wing) : undefined;
const isUnfiled = id === 'unfiled';
const name = legacy?.name ?? wing?.name ?? 'Across regions & unrecorded origins';
const blurb = legacy?.line ?? wing?.blurb ?? 'Works with origins spanning several regions, or without enough recorded regional evidence for a single wing.';
const eraOrder = ['Ancient', 'Medieval', 'Renaissance', 'Early modern', 'Modern', 'Contemporary', 'Undated'];
const rooms = eraOrder
  .map((era) => ({ era, works: wingWorks.filter((work) => work.era === era) }))
  .filter((room) => room.works.length > 0);
const showRooms = Boolean(wing && rooms.length > 1);
---

<V3Layout
  title={name}
  description={blurb}
  image={featured?.thumbnailImage}
>
  {(isUnfiled || legacy) && <meta slot="head" name="robots" content="noindex, follow" />}
  {legacy ? <header class="v3-page-hero legacy-wing-entrance">
    <p class="v3-kicker">A new arrangement / The museum wings</p>
    <h1 class="v3-display">{legacy.name}</h1>
    <p>{legacy.line}</p>
    <div class="v3-actions">{legacy.destinations.map(destination => {
      const nextWing = wingById(destination);
      return nextWing && <a class="v3-button v3-button--ghost" href={withBase(`/wings/${destination}/`)}>{nextWing.name} <span aria-hidden="true">→</span></a>;
    })}</div>
    <p><a href={withBase('/wings/')}>Explore all {wings.length} wings</a> · <a href={withBase('/world/')}>Explore the globe</a> · <a href={withBase('/collection/')}>Browse every work</a></p>
  </header> : <div style={'--wing-accent:'+wingAccent(id)}>

  {featured ? (
    <section class="v3-wing-hero" aria-labelledby="wing-title" data-featured-work={featured.slug}>
      <div class="v3-wing-hero__copy">
        <p class="v3-kicker">Wing {String(wingIndex + 1).padStart(2, '0')} · {wingWorks.length} {wingWorks.length === 1 ? 'work' : 'works'}</p>
        <h1 id="wing-title" class="v3-display">{name}</h1>
        <p>{blurb}</p>
        <div class="v3-wing-hero__meta">
          <span>Featured in 3D</span>
          <strong>{featured.title}</strong>
          <span>{[featured.maker, featured.displayDate].filter(Boolean).join(' · ')}</span>
        </div>
        <div class="v3-actions">
          <a class="v3-button v3-button--light" href={withBase(v3WorkRoute(featured))}>View object <span>↗</span></a>
          <a class="v3-button v3-button--ghost" href="#wing-works">Browse the wing <span>↓</span></a>
        </div>
      </div>
      <div class="v3-wing-hero__viewer">
        <Viewer
          glb={withBase(featured.modelGlb)}
          poster={withBase(featured.thumbnailImage)}
          title={featured.title}
          hud={false}
          immersive={true}
          posterLoading="eager"
          upAxis={featured.modelUpAxis}
          modelTransform={featured.modelTransform}
          materialAppearance={featured.materialAppearance}
        />
      </div>
    </section>
  ) : (
    <header class="v3-page-hero">
      <p class="v3-kicker">The collection / {wingWorks.length} {wingWorks.length === 1 ? 'work' : 'works'}</p>
      <h1 class="v3-display">{name}</h1>
      <p>{blurb} Explore them here, or <a href={withBase('/collection/')}>browse the complete collection</a>.</p>
    </header>
  )}

  <section class="v3-wing-works" id="wing-works" aria-labelledby="wing-works-title">
    <div class="v3-wing-works__intro">
      <div>
        <p class="v3-kicker">The collection / chronological order</p>
        <h2 id="wing-works-title" class="v3-display">{isUnfiled ? 'Beyond a single region.' : `Inside ${name}.`}</h2>
      </div>
      {!isUnfiled && <a href={withBase('/wings/')}>All wings →</a>}
    </div>

    {wingWorks.length === 0 ? (
      <p class="v3-wing-empty">Every public work currently has a wing.</p>
    ) : showRooms ? (
      <div class="v3-wing-rooms">
        {rooms.map((room, roomIndex) => {
          const preceding = rooms.slice(0, roomIndex).reduce((total, candidate) => total + candidate.works.length, 0);
          return (
            <section class="v3-wing-room" aria-labelledby={`room-${roomIndex}`}>
              <header class="v3-wing-room__head">
                <p class="v3-kicker">Room {String(roomIndex + 1).padStart(2, '0')} · {room.works.length} {room.works.length === 1 ? 'work' : 'works'}</p>
                <h3 id={`room-${roomIndex}`} class="v3-display">{room.era}</h3>
              </header>
              <div class="v3-grid">
                {room.works.map((work, index) => <V3WorkCard work={work} eager={preceding + index < 8} />)}
              </div>
            </section>
          );
        })}
      </div>
    ) : (
      <div class="v3-grid">
        {wingWorks.map((work, index) => <V3WorkCard work={work} eager={index < 8} />)}
      </div>
    )}
  </section>
  </div>}
</V3Layout>

<style>.legacy-wing-entrance .v3-actions { margin-block:28px; } .legacy-wing-entrance > p:last-child { font-size:13px; } .legacy-wing-entrance > p:last-child a { text-underline-offset:4px; }</style>
