---
import V3WingGrid from '../../components/v3/V3WingGrid.astro';
import V3Layout from '../../layouts/v3/V3Layout.astro';
import { wingSummaries } from '../../lib/wings';

const leadImage = wingSummaries[0]?.featured?.thumbnailImage;
---

<V3Layout
  title="Wings"
  description="Browse the permanent collection through six geographic and historical wings."
  image={leadImage}
>
  <header class="v3-page-hero">
    <p class="v3-kicker">Permanent collection / 06 wings</p>
    <h1 class="v3-display">Explore art<br /><em>by region.</em></h1>
    <p>Explore six geographic and historical wings. Works are arranged by period within each wing, while exhibitions bring works from different regions together.</p>
  </header>

  <section class="v3-wings" aria-label="Museum wings">
    <V3WingGrid />
  </section>
</V3Layout>
