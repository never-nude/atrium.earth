---
import V3CollectionExplorer from '../../components/v3/V3CollectionExplorer.astro';
import V3Layout from '../../layouts/v3/V3Layout.astro';
import { collectionCount, featuredWork, works } from '../../lib/v3';
---

<V3Layout
  title="Explore the collection"
  description={`Search and wander through all ${collectionCount} sculptures in Atrium.Earth.`}
  image={featuredWork.thumbnailImage}
>
  <header class="v3-page-hero">
    <p class="v3-kicker">The collection / {collectionCount} works</p>
    <h1 class="v3-display">Find one.<br /><em>Then get closer.</em></h1>
    <p>Search if you know what you want. Filter if you have a hunch. Or scroll until something stops you.</p>
  </header>

  <section class="v3-collection" aria-label="All works">
    <V3CollectionExplorer works={works} />
  </section>
</V3Layout>
