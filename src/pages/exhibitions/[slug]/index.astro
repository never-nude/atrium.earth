---
import V3Layout from '../../../layouts/v3/V3Layout.astro';
import Viewer from '../../../components/Viewer.astro';
import ExhibitionComparisons from '../../../components/ExhibitionComparisons.astro';
import CuratedVisit from '../../../components/CuratedVisit.astro';
import { exhibitions, exhibitionFeaturedWork, nextExhibition, type V3Exhibition, v3ExhibitionRoute, v3WorkRoute } from '../../../lib/v3';
import { isFeaturedWork } from '../../../lib/catalog';
import { withBase } from '../../../lib/urls';
import { shortWorkTitle } from '../../../lib/work-titles';
import { curatedVisitFor } from '../../../lib/curated-visit.ts';

export function getStaticPaths() {
  return exhibitions.map((exhibition) => ({ params: { slug: exhibition.slug }, props: { exhibition } }));
}

type Props = { exhibition: V3Exhibition };
const { exhibition } = Astro.props;
const lead = exhibitionFeaturedWork(exhibition);
const next = nextExhibition(exhibition);
const visit = curatedVisitFor(exhibition);
const comparisons = exhibition.comparisons ?? [];
const heroComparison = comparisons.find((pair) => pair.works.every(isFeaturedWork));
const firstStop = comparisons.length ? '#pair-1' : '#stop-1';
const stops = exhibition.works.map((work, index) => ({
  work,
  index: index + 1,
  text: exhibition.captions[work.slug] || '',
  meta: [work.maker || work.culture, work.displayDate, work.medium || work.materials.join(', ')].filter(Boolean).join(' · '),
}));
---

<V3Layout title={exhibition.title} description={exhibition.summary} image={lead.thumbnailImage}>
  <header class="v3-exhero v3-exhero--interactive" style={`--ex-accent:${exhibition.accent}`}>
    {heroComparison ? (
      <div class="exhibition-duet" aria-label="Featured works, side by side">
        {heroComparison.works.map((work) => (
          <figure class="v3-float v3-float--soft" data-featured-work={work.slug}>
            <img src={withBase(work.thumbnailImage)} alt={work.title} width="720" height="900" loading="eager" decoding="async" />
            <figcaption>{exhibition.workNotes?.[work.slug]?.artist || work.maker} · {shortWorkTitle(work.title)}</figcaption>
          </figure>
        ))}
      </div>
    ) : <div class="v3-exhero__viewer v3-exhibition-viewer v3-float v3-float--soft" data-featured-work={lead.slug}>
      <Viewer
        glb={lead.modelGlb ? withBase(lead.modelGlb) : ''}
        poster={withBase(lead.thumbnailImage)}
        title={lead.title}
        hud={false}
        immersive={true}
        autoStart="visible"
        autoRotateSpeed={0.25}
        posterLoading="eager"
        upAxis={lead.modelUpAxis}
        modelTransform={lead.modelTransform}
        materialAppearance={lead.materialAppearance}
      />
    </div>}
    <div class="v3-exhero__copy">
      <p class="v3-kicker">Exhibition {exhibition.number} · {exhibition.kicker}</p>
      <h1 class="v3-display">{exhibition.title}</h1>
      <p class="v3-exhero__summary">{exhibition.summary}</p>
      <p class="v3-exhero__meta"><span>{stops.length} works{comparisons.length ? ` · ${comparisons.length} pairings` : ''}</span><span>Allow 15–30 minutes</span><span>3D views and records</span></p>
      {visit ? <div class="exhibition-entrance-actions"><a class="exhibition-entrance-actions__guided" href="#curated-visit" data-curated-launch>Take a 5-minute visit <span aria-hidden="true">→</span></a><a href="#all-exhibition-works" data-visit-all>Explore all {stops.length} works <span aria-hidden="true">↓</span></a></div> : <a class="v3-exhero__begin" href={firstStop}>Begin exhibition <span aria-hidden="true">↓</span></a>}
    </div>
  </header>

  <section class="v3-exintro">
    <p class="v3-kicker">About this exhibition</p>
    <div>
      <p class="v3-editorial">{exhibition.invitation}</p>
      {exhibition.viewingNote && <p class="exhibition-viewing-note">{exhibition.viewingNote}</p>}
      {comparisons.length > 0 && (
        <nav class="exhibition-pair-index" aria-label="Exhibition pairings">
          {comparisons.map((pair, index) => <a href={`#pair-${index + 1}`}><span>{String(index + 1).padStart(2, '0')}</span>{pair.title}</a>)}
        </nav>
      )}
    </div>
  </section>

  {visit && <CuratedVisit visit={visit} accent={exhibition.accent} />}

  <div id="all-exhibition-works" data-exhibition-full>
  {visit && <header class="exhibition-full-heading"><p class="v3-kicker">The complete exhibition</p><h2 tabindex="-1" data-exhibition-full-title>Explore all {stops.length} works.</h2><a href="#curated-visit" data-curated-launch>Take the six-work visit <span aria-hidden="true">↑</span></a></header>}
  {comparisons.length ? <ExhibitionComparisons exhibition={exhibition} /> : <div class="v3-walk" style={`--ex-accent:${exhibition.accent}`}>
    {stops.map((stop) => (
      <article class="v3-stop v3-reveal" id={`stop-${stop.index}`} data-v3-stop={stop.index} data-exhibition-work={stop.work.slug} aria-label={`Stop ${stop.index}: ${stop.work.title}`}>
        <div class="v3-stop__viewer v3-exhibition-viewer v3-float" style={`view-transition-name: w-${stop.work.id};`}>
          <Viewer
            glb={stop.work.modelGlb ? withBase(stop.work.modelGlb) : ''}
            poster={withBase(stop.work.thumbnailImage)}
            title={stop.work.title}
            hud={false}
            immersive={true}
            autoStart="visible"
            posterLoading="lazy"
            upAxis={stop.work.modelUpAxis}
            modelTransform={stop.work.modelTransform}
            materialAppearance={stop.work.materialAppearance}
          />
        </div>
        <div class="v3-stop__copy">
          <span class="v3-stop__no" aria-hidden="true">{String(stop.index).padStart(2, '0')}</span>
          <h2>{stop.work.title}</h2>
          {stop.meta && <p class="v3-stop__meta">{stop.meta}</p>}
          {stop.text && <p class="v3-wall">{stop.text}</p>}
          <a class="v3-stop__open" href={`${withBase(v3WorkRoute(stop.work))}?${new URLSearchParams({ exhibition: exhibition.slug })}`}>Details &amp; sources <span>↗</span></a>
        </div>
      </article>
    ))}
  </div>}

  <footer class="v3-coda" style={`--ex-accent:${exhibition.accent}`}>
    <p class="v3-kicker">Further consideration</p>
    {exhibition.coda && <p class="v3-wall">{exhibition.coda}</p>}
    <a class="v3-coda__next" href={withBase(v3ExhibitionRoute(next))}>
      <span>Next exhibition · {next.number}</span>
      <strong>{next.title} →</strong>
    </a>
  </footer>
  </div>

</V3Layout>

<style>
  .exhibition-entrance-actions { display:flex; flex-wrap:wrap; gap:12px 24px; align-items:center; margin-top:24px; }
  .exhibition-entrance-actions a:not(.exhibition-entrance-actions__guided) { background: transparent; }
  .exhibition-entrance-actions a { display:inline-flex; align-items:center; justify-content:center; gap:14px; min-height:44px; margin:0; padding:10px 15px; border:1px solid var(--v3-line-strong); border-radius:7px; color:var(--v3-ink); font-size:12px; line-height:1.5; text-decoration:none; }
  .exhibition-entrance-actions .exhibition-entrance-actions__guided { background:var(--ex-accent); border-color:var(--ex-accent); color:#152239; }
  #all-exhibition-works { scroll-margin-top:0; }
  .exhibition-full-heading { max-width:var(--v3-max); margin:0 auto 38px; padding:30px var(--v3-pad) 0; border-top:1px solid var(--v3-line); }
  .exhibition-full-heading h2 { margin:0 0 14px; color:var(--v3-ink); font-size:clamp(26px,3vw,40px); font-weight:500; letter-spacing:-.03em; }
  .exhibition-full-heading a { display:inline-flex; align-items:center; gap:12px; min-height:44px; color:var(--v3-signal); font-size:12px; text-underline-offset:4px; }
  .exhibition-duet { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 4vw, 60px); width: min(100%, 1100px); margin: 0 auto; }
  .exhibition-duet figure { min-width: 0; margin: 0; }
  .exhibition-duet img { display: block; width: 100%; height: clamp(240px, 52svh, 620px); object-fit: contain; }
  .exhibition-duet figcaption { margin-top: 12px; color: var(--v3-muted); font-size: .7rem; line-height: 1.5; text-align: center; }
  .exhibition-viewing-note { max-width: 64ch; margin: 28px 0 0; color: var(--v3-muted); font-size: .92rem; line-height: 1.6; }
  .exhibition-pair-index { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; max-width: 800px; margin-top: 36px; }
  .exhibition-pair-index a { display: flex; gap: 16px; align-items: baseline; min-height: 44px; padding: 14px 0; border-top: 1px solid var(--v3-line); color: var(--v3-ink); font-size: .85rem; line-height: 1.4; text-decoration: none; }
  .exhibition-pair-index a:hover { color: var(--v3-signal); }
  .exhibition-pair-index span { color: var(--v3-muted); font-size: .67rem; }
  @media (max-width: 650px) {
    .exhibition-duet img { height: clamp(215px, 72vw, 390px); }
    .exhibition-duet figcaption { font-size: .62rem; }
    .exhibition-pair-index { grid-template-columns: 1fr; }
  }
</style>
