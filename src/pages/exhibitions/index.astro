---
import V3Layout from '../../layouts/v3/V3Layout.astro';
import { exhibitionFeaturedWork, v3ExhibitionRoute } from '../../lib/v3';
import { currentProgramme } from '../../lib/programme';
import { withBase } from '../../lib/urls';
const { exhibitions, focus, focusIntro } = currentProgramme;
---

<V3Layout
  title="Exhibitions"
  description="Curated groups of works that support close comparison across the Atrium.Earth collection."
  image={exhibitionFeaturedWork(focus).thumbnailImage}
>
  <header class="v3-page-hero">
    <p class="v3-kicker">Curated exhibitions / {String(exhibitions.length).padStart(2, '0')}</p>
    <h1 class="v3-display">Works in context.<br /><em>Questions to consider.</em></h1>
    <p>Each exhibition brings a focused group of works together around a shared subject. Follow the sequence or open any work for its full record and 3D view.</p>
    <p class="v3-weekly-focus" style={`--ex-accent:${focus.accent}`}><span>Featured exhibition · {focus.title}</span>{focusIntro}</p>
  </header>

  <section class="v3-exlist" style="margin: 0 var(--v3-pad) 140px;" aria-label="Current exhibitions">
    {exhibitions.map((exhibition) => (
      <a class="v3-exrow" href={withBase(v3ExhibitionRoute(exhibition))} style={`--ex-accent:${exhibition.accent}`} data-exhibition={exhibition.slug}>
        <span class="v3-exrow__no">{exhibition.number}</span>
        <div>
          <p class="v3-exrow__kicker">{exhibition.slug === focus.slug && <span>Featured · </span>}{exhibition.kicker}</p>
          <h3>{exhibition.title}</h3>
        </div>
        <p class="v3-exrow__summary">{exhibition.summary}</p>
        <span class="v3-exrow__img v3-float"><img src={withBase(exhibitionFeaturedWork(exhibition).thumbnailImage)} alt="" width="240" height="300" loading="lazy" decoding="async" /></span>
        <b aria-hidden="true">↗</b>
      </a>
    ))}
  </section>
</V3Layout>
