---
import Viewer from '../components/Viewer.astro';
import V3WorkCard from '../components/v3/V3WorkCard.astro';
import V3WingGrid from '../components/v3/V3WingGrid.astro';
import { newestWorks } from '../lib/additions';
import FeaturedExhibition from '../components/home/FeaturedExhibition.astro';
import LookingTogether from '../components/home/LookingTogether.astro';
import SpatialInvitation from '../components/home/SpatialInvitation.astro';
import WorldExplorer from '../components/WorldExplorer.astro';
import V3Layout from '../layouts/v3/V3Layout.astro';
import { collectionCount, v3WorkRoute } from '../lib/v3';
import { currentProgramme } from '../lib/programme';
import { featuredWorks } from '../lib/catalog';
import { withBase } from '../lib/urls';
import { arVrCount } from '../lib/spatial-catalog';
import { shortWorkTitle } from '../lib/work-titles';
import { wingSummaries } from '../lib/wings';

const randomRoutes = featuredWorks.map((work) => withBase(v3WorkRoute(work)));
const { hero: featuredWork } = currentProgramme;
const heroAppearance = {
  ...featuredWork.materialAppearance,
  backdropTop: '#1c2b41',
  backdropBase: '#15243a',
  backdropGlow: '#c9d2dc',
  backdropGlowStrength: 0.08,
};

// Alt text describes the work the way a wall label would: title, maker, date,
// medium. Placeholder record values never make it into the description.
const recorded = (value: string) => value && !/not yet recorded|pending|unassigned/i.test(value) ? value : '';
const heroMaker = recorded(featuredWork.maker);
const heroDate = recorded(featuredWork.displayDate);
const heroMedium = recorded(featuredWork.medium);
const heroAlt = [
  `${[featuredWork.title, heroMaker, heroDate].filter(Boolean).join(', ')}.`,
  heroMedium ? `${heroMedium} sculpture in a still view against a dark ground.` : 'Still view of the sculpture against a dark ground.',
].join(' ');
---

<V3Layout
  title="Atrium.Earth"
  description={`Explore ${collectionCount} sculptures in 3D, save favourites, and visit themed galleries. ${arVrCount} models are available in AR and VR on compatible devices.`}
  image={featuredWork.thumbnailImage}
>
  <div class="home-programme" data-programme data-programme-week={currentProgramme.weekKey} data-programme-day={currentProgramme.dayKey} data-programme-layout={currentProgramme.layout} data-programme-hero={featuredWork.slug} style={`--home-programme-accent:${currentProgramme.accent}`}>
  <section class="v3-hero home-programme-hero" aria-labelledby="v3-home-title" data-home-section="hero" data-featured-work={featuredWork.slug}>
    <div class="v3-hero__viewer">
      <Viewer
        glb={withBase(featuredWork.modelGlb)}
        modelBytes={featuredWork.modelBytes}
        poster={withBase(featuredWork.thumbnailImage)}
        posterAlt={heroAlt}
        title={featuredWork.title}
        hud={false}
        immersive={true}
        posterLoading="eager"
        upAxis={featuredWork.modelUpAxis}
        modelTransform={featuredWork.modelTransform}
        materialAppearance={heroAppearance}
        autoStart={false}
        displayControls={true}
      />
    </div>

    <div class="v3-hero__veil" aria-hidden="true"></div>
    <div class="v3-hero__copy">
      <p class="v3-kicker">A museum you can move through</p>
      <h1 id="v3-home-title" class="v3-display">A closer look<br />at sculpture.</h1>
      <p class="v3-hero__lede">Turn sculpture in 3D. Follow a short curated visit, or find your own way through {collectionCount.toLocaleString('en-US')} works.</p>
      <div class="v3-actions">
        <a class="v3-button v3-button--light" href={withBase('/exhibitions/the-work-of-the-surface/#curated-visit')}>A 5-minute visit <span aria-hidden="true">→</span></a>
        <a class="v3-button v3-button--ghost" href={withBase('/collection/')}>Browse all works <span aria-hidden="true">↗</span></a>
      </div>
      <p class="home-hero-prompt"><span>Look closely</span>{currentProgramme.heroPrompt}</p>
    </div>

    <div class="v3-hero__object">
      <span>Featured work</span>
      <strong>{shortWorkTitle(featuredWork.title)}</strong>
      <span>{[heroMaker, heroDate || 'Date unrecorded'].filter(Boolean).join(' · ')}</span>
      <a class="v3-hero__record-link" href={withBase(v3WorkRoute(featuredWork))}>View this work <span aria-hidden="true">↗</span></a>
    </div>
    <a class="v3-hero__continue" href="#v3-home-content">Explore more <span>↓</span></a>
  </section>

  <div id="v3-home-content"></div>
  <FeaturedExhibition />
  <LookingTogether />
  <SpatialInvitation />

  <section class="v3-section v3-section--line home-wings" aria-labelledby="wings-home-title" data-home-section="wings">
    <WorldExplorer compact={true} />
    <div class="v3-section-head v3-section-head--split">
      <div><p class="v3-kicker">04 / Museum wings</p><h2 id="wings-home-title" class="v3-display">Follow your curiosity.</h2></div>
      <a href={withBase('/wings/')}>Explore all {wingSummaries.length} wings <span aria-hidden="true">→</span></a>
    </div>
    <p class="home-section-intro">Explore by region, then by period. Each work has one primary home when its regional origin is known.</p>
    <V3WingGrid compact={true} />
  </section>

  {newestWorks.length > 0 && (
    <section class="v3-section v3-section--line v3-additions-home home-newest" aria-labelledby="new-title" data-home-section="newest">
      <div class="v3-section-head v3-section-head--split">
        <div><p class="v3-kicker">05 / Recent additions</p><h2 id="new-title" class="v3-display">New to Atrium.</h2></div>
        <a href={withBase('/newest/')}>View newest additions <span aria-hidden="true">→</span></a>
      </div>
      <p class="home-section-intro">Explore the latest additions to the 3D collection.</p>
      <div class="v3-grid">{newestWorks.slice(0, 4).map((work) => <V3WorkCard work={work} />)}</div>
    </section>
  )}

  <section class="v3-section v3-random home-random" aria-labelledby="random-title" data-home-section="discovery">
    <p class="v3-kicker">06 / A different starting point</p>
    <h2 id="random-title">Choose a work at random.</h2>
    <p>A different starting point can change what you notice.</p>
    <a class="v3-random__button" href={randomRoutes[0]} data-random-work>Choose a work <span>↗</span></a>
  </section>

  </div>

  <script>
    const featuredViewer = document.querySelector('.home-programme-hero [data-viewer]');
    const featuredStart = featuredViewer?.querySelector('.viewer-start');
    if (featuredViewer && featuredStart) {
      const tools = featuredViewer.querySelectorAll('[data-immersive-tools], [data-display-controls]');
      const row = document.createElement('div');
      row.className = 'home-featured-controls v3-object-viewer-controls';
      row.append(...tools);
      featuredStart.after(row);
    }
  </script>

  <script define:vars={{ randomRoutes }}>
    const randomLink = document.querySelector('[data-random-work]');
    randomLink?.addEventListener('click', (event) => {
      event.preventDefault();
      const next = randomRoutes[Math.floor(Math.random() * randomRoutes.length)];
      window.location.href = next;
    });
  </script>
</V3Layout>

<style>
  .home-programme-hero { border-top: 2px solid var(--home-programme-accent, var(--v3-signal)); }
  .home-programme-hero { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); grid-template-rows: 1fr auto; height: auto; min-height: min(680px, calc(100svh - 74px)); padding: 32px var(--v3-pad); column-gap: 32px; }
  .home-programme-hero > .v3-hero__viewer { position: relative; inset: auto; grid-column: 2; grid-row: 1; --hero-artwork-height: clamp(370px, 57svh, 610px); height: auto; }
  .home-programme-hero :global(.viewer:not(:fullscreen):not([data-viewer-expanded])) { height: auto; }
  .home-programme-hero :global(.viewer:not(:fullscreen):not([data-viewer-expanded]) > .model-stage) { height: var(--hero-artwork-height); }
  /* The recovery JPEG still has the original backdrop. */
  .home-programme-hero :global(.model-stage:not([data-rendered-still]) [data-poster][src*="/thumb.jpg"]) {
    inset: 50% auto auto 50%;
    width: min(100%, calc(var(--hero-artwork-height) * .8));
    height: auto;
    min-height: 0;
    transform: translate(-50%, -50%);
    mask-image: linear-gradient(to right, transparent, black 15% 85%, transparent),
      linear-gradient(to bottom, transparent, black 12% 88%, transparent);
    mask-composite: intersect;
  }
  .home-programme-hero :global(.viewer:not(:fullscreen):not([data-viewer-expanded]) > .viewer-start) { justify-content: center; }
  .home-programme-hero :global(.home-featured-controls) { margin: 0; border-top: 0; flex-wrap: wrap; }
  .home-programme-hero :global(.home-featured-controls:not(:has([data-immersive-tools]:not([hidden])))) { display: none; }
  .home-programme-hero :global(.viewer:not(:fullscreen):not([data-viewer-expanded]) .home-featured-controls .immersive-tools:not([hidden])) { display: flex !important; position: static; flex: 1 1 auto; justify-content: flex-start; gap: 2px; padding: 0; border: 0; border-radius: 0; background: transparent; backdrop-filter: none; transform: none; }
  .home-programme-hero :global(.viewer:not(:fullscreen):not([data-viewer-expanded]) .home-featured-controls .immersive-light) { position: relative; }
  .home-programme-hero :global(.viewer:not(:fullscreen):not([data-viewer-expanded]) .home-featured-controls .immersive-light[open]) { width: 100%; }
  .home-programme-hero :global(.viewer:not(:fullscreen):not([data-viewer-expanded]) .home-featured-controls .immersive-light__panel) { position: static; width: 100%; margin-top: 8px; box-shadow: none; }
  .home-programme-hero :global(.viewer:is(:fullscreen, [data-viewer-expanded]) .home-featured-controls .immersive-tools:not([hidden])) { display: flex !important; position: absolute; inset: auto 12px max(28px, env(safe-area-inset-bottom)) 12px; transform: none; }
  .home-programme-hero > .v3-hero__copy { position: relative; inset: auto; grid-column: 1; grid-row: 1 / 3; align-self: center; width: auto; max-width: 580px; margin: 0; padding: 20px 0; }
  .home-programme-hero .v3-hero__copy h1 { margin: 18px 0; font-size: clamp(42px, 5.2vw, 78px); line-height: 1.06; }
  .home-programme-hero > .v3-hero__object { position: relative; inset: auto; grid-column: 2; grid-row: 2; justify-self: center; display: grid; justify-items: center; gap: 4px; max-width: 54ch; margin: 8px 0 0; padding: 0; text-align: center; }
  .home-programme-hero .v3-hero__object strong { display: block; font-size: 15px; }
  .home-programme-hero .v3-hero__object > span:first-child { font-size: 9px; }
  .home-programme-hero .v3-hero__object span + span::before { content: none; }
  .home-programme-hero .v3-hero__record-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--v3-signal); text-underline-offset: 4px; }
  .home-programme-hero > .v3-hero__veil, .home-programme-hero > .v3-hero__continue { display: none; }
  .home-hero-prompt { max-width: 38ch; margin: 22px 0 0; padding-left: 14px; border-left: 2px solid var(--home-programme-accent); color: var(--v3-muted); font-size: 12px; line-height: 1.65; }
  .home-hero-prompt > span { display: block; margin-bottom: 5px; color: var(--home-programme-accent); font-size: 9px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .home-section-intro { max-width: 66ch; margin: -8px 0 30px; color: var(--v3-muted); font-size: 14px; line-height: 1.7; }
  .home-wings :global(.v3-wing-card__image) { aspect-ratio: 3 / 2; }
  .home-wings :global(.v3-wing-card__copy > strong) { font-size: clamp(23px, 2.25vw, 31px); }
  .home-wings :global(.v3-wing-card__blurb) { font-size: 12px; }
  .home-wings :global(.v3-wing-card__link) { margin-top: 20px; }
  .home-random { min-height: 0; padding-block: 76px; }
  @media (max-width: 800px) {
    .home-programme-hero { display: flex; flex-direction: column; min-height: 0; padding: 26px 0 28px; }
    .home-programme-hero > .v3-hero__copy { order: 0; align-self: stretch; max-width: none; width: auto; margin: 0; padding: 0 var(--v3-pad); }
    .home-programme-hero .v3-hero__copy h1 { margin: 12px 0; font-size: clamp(37px, 9.6vw, 60px); }
    .home-programme-hero .v3-hero__copy .v3-kicker { margin: 0; font-size: 9px; }
    .home-programme-hero .v3-hero__lede { max-width: 48ch; font-size: 13px; line-height: 1.65; }
    .home-programme-hero .v3-actions { flex-direction: row; align-items: stretch; margin-top: 18px; gap: 8px; }
    .home-programme-hero .v3-button { flex: 1 1 140px; min-height: 46px; padding: 11px 13px; gap: 12px; font-size: 10px; }
    .home-programme-hero > .v3-hero__viewer { order: 1; width: 100%; --hero-artwork-height: clamp(260px, 39svh, 400px); margin-top: 16px; }
    .home-programme-hero :global(.home-featured-controls) { margin-inline: var(--v3-pad); }
    .home-programme-hero :global(.home-featured-controls .immersive-tools button),
    .home-programme-hero :global(.home-featured-controls .immersive-light summary) { min-height: 44px; padding-inline: 9px; font-size: 10px; }
    .home-programme-hero > .v3-hero__object { order: 2; align-self: center; max-width: calc(100% - 40px); margin: 0; }
    .home-programme-hero .home-hero-prompt { display: none; }
  }
  @media (max-width: 700px) {
    .home-hero-prompt { margin-top: 18px; font-size: 12px; }
    .home-wings :global(.v3-wings-grid) { gap: 28px; }
    .home-wings :global(.v3-wing-card) { grid-template-columns: 112px minmax(0, 1fr); grid-template-rows: 1fr; column-gap: 14px; padding-top: 14px; }
    .home-wings :global(.v3-wing-card__image) { aspect-ratio: 4 / 5; align-self: start; }
    .home-wings :global(.v3-wing-card__number) { top: 18px; left: 5px; font-size: 9px; }
    .home-wings :global(.v3-wing-card__copy) { padding: 0 0 0 2px; }
    .home-wings :global(.v3-wing-card__copy > strong) { margin-top: 8px; font-size: 22px; }
    .home-wings :global(.v3-wing-card__blurb) { margin-top: 9px; font-size: 11px; }
    .home-wings :global(.v3-wing-card__link) { margin-top: 12px; padding-top: 10px; font-size: 9px; }
    .home-section-intro { font-size: 13px; }
    .home-random { padding-block: 52px; }
  }
  @media (max-width: 360px) {
    .home-wings :global(.v3-wing-card) { grid-template-columns: 88px minmax(0, 1fr); column-gap: 12px; }
    .home-wings :global(.v3-wing-card__copy > strong) { font-size: 20px; }
  }
</style>
