---
import Viewer from '../components/Viewer.astro';
import V3WorkCard from '../components/v3/V3WorkCard.astro';
import { newestWorks } from '../lib/additions';
import V3WingGrid from '../components/v3/V3WingGrid.astro';
import V3Layout from '../layouts/v3/V3Layout.astro';
import { collectionCount, exhibitions, exhibitionFeaturedWork, homepageFeaturedWork as featuredWork, pairings, v3ExhibitionRoute, v3WorkRoute } from '../lib/v3';
import { featuredWorks } from '../lib/catalog';
import { withBase } from '../lib/urls';
import { arVrFeatured, arVrCount, arVrVerifiedCount } from '../lib/spatial-catalog';

const randomRoutes = featuredWorks.map((work) => withBase(v3WorkRoute(work)));
const spatialRooms = [
  { id: 'ancient-egypt', title: 'Faces of Ancient Egypt' },
  { id: 'compassion', title: 'Compassion and Contemplation' },
  { id: 'divine-gestures', title: 'Divine Gestures' },
  { id: 'painted-devotion', title: 'Painted Devotion' },
  { id: 'human-gesture', title: 'The Human Gesture' },
  { id: 'greco-roman', title: 'The Classical World' },
];
const heroAppearance = {
  ...featuredWork.materialAppearance,
  backdropTop: '#1c2b41',
  backdropBase: '#15243a',
  backdropGlow: '#c7b9ff',
  backdropGlowStrength: 0.08,
};
const heroTransform = { ...featuredWork.modelTransform, fit: 1.1 };

// Alt text describes the work the way a wall label would: title, maker, date,
// medium. Placeholder record values never make it into the description.
const recorded = (value: string) => value && !/not yet recorded|pending|unassigned/i.test(value) ? value : '';
const heroMaker = recorded(featuredWork.maker);
const heroDate = recorded(featuredWork.displayDate);
const heroMedium = recorded(featuredWork.medium);
const heroAlt = [
  `${[featuredWork.title, heroMaker, heroDate].filter(Boolean).join(', ')}.`,
  heroMedium ? `${heroMedium} sculpture in a still view against a dark ground.` : 'Still view of the sculpture against a dark ground.',
].join(' ');
---

<V3Layout
  title="Atrium.Earth"
  description={`Explore ${collectionCount} works in 3D and all ${arVrCount} compatible models in AR and VR. Verified, approximate and unknown dimensions are clearly labeled.`}
  image={featuredWork.thumbnailImage}
>
  <section class="v3-hero" aria-labelledby="v3-home-title" data-featured-work={featuredWork.slug}>
    <div class="v3-hero__viewer">
      <Viewer
        glb={withBase(featuredWork.modelGlb)}
        poster={withBase(featuredWork.thumbnailImage)}
        posterAlt={heroAlt}
        title={featuredWork.title}
        hud={false}
        immersive={true}
        posterLoading="eager"
        upAxis={featuredWork.modelUpAxis}
        modelTransform={heroTransform}
        materialAppearance={heroAppearance}
        autoRotate={true}
        turntableDegreesPerSecond={4}
        respectReducedMotion={true}
        rotationControl="simple"
      />
    </div>

    <div class="v3-hero__veil" aria-hidden="true"></div>
    <div class="v3-hero__copy">
      <p class="v3-kicker">The sculpture collection</p>
      <h1 id="v3-home-title" class="v3-display">A closer look<br />at sculpture.</h1>
      <p class="v3-hero__lede">Across centuries and continents. Find a work, turn it in your hands, and make a collection of your own.</p>
      <div class="v3-actions">
        <a class="v3-button v3-button--light" href={withBase('/collection/')}>Explore the collection <span aria-hidden="true">↗</span></a>
        <a class="v3-button v3-button--ghost" href={withBase('/newest/')}>See what’s new <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="v3-hero__object">
      <span>Featured work</span>
      <strong>{featuredWork.title}</strong>
      <span>{[featuredWork.maker, featuredWork.displayDate].filter(Boolean).join(' · ')}</span>
      <a class="v3-hero__record-link" href={withBase(v3WorkRoute(featuredWork))}>View this work <span aria-hidden="true">↗</span></a>
    </div>
    <a class="v3-hero__continue" href="#v3-home-content">Explore more <span>↓</span></a>
  </section>

  <section class="v3-section studio-museum-entry" aria-labelledby="studio-museum-title">
    <div class="studio-museum-entry__copy">
      <p class="v3-kicker">Spatial museum / Six exhibitions</p>
      <h2 id="studio-museum-title" class="v3-display">Step inside the collection.</h2>
      <p>Explore six themed rooms with sculptures shown at documented or approximate physical size.</p>
    </div>
    <a class="v3-button v3-button--light studio-museum-entry__enter" href={withBase('/spatial-museum/')}>
      Enter the spatial museum <span aria-hidden="true">↗</span>
    </a>
    <nav class="studio-museum-entry__rooms" aria-label="Spatial museum exhibitions">
      <ol>
        {spatialRooms.map((room, index) => (
          <li>
            <a href={withBase(`/spatial-museum/?room=${room.id}`)}>
              <span class="studio-museum-entry__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span>{room.title}</span>
              <span class="studio-museum-entry__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  {newestWorks.length > 0 && (
    <section class="v3-section v3-section--line v3-additions-home" id="v3-home-content" aria-labelledby="new-title">
      <div class="v3-section-head v3-section-head--split">
        <div><p class="v3-kicker">01 / Newest additions</p><h2 id="new-title" class="v3-display">Just arrived.</h2></div>
        <a href={withBase('/newest/')}>View newest additions <span aria-hidden="true">→</span></a>
      </div>
      <div class="v3-grid">{newestWorks.slice(0, 4).map((work) => <V3WorkCard work={work} />)}</div>
    </section>
  )}

  <section class="v3-section v3-spatial-feature v3-section--line" aria-labelledby="spatial-feature-title">
    <div class="v3-section-head v3-section-head--split">
      <div>
        <p class="v3-kicker">02 / AR / VR</p>
        <h2 id="spatial-feature-title" class="v3-display">See sculpture<br />in your space.</h2>
      </div>
      <a href={withBase('/ar-vr/')}>Explore {arVrCount} works <span aria-hidden="true">→</span></a>
    </div>
    <div class="v3-spatial-feature__intro">
      <p class="v3-editorial">Explore all {arVrCount} compatible models in AR on your phone or in VR. {arVrVerifiedCount} carry reviewed size references, including clearly labeled cast measurements.</p>
      <p class="v3-spatial-feature__note"><strong class="v3-dimension-status" data-dimension-status="verified">Verified dimensions</strong> use reviewed measurements. <strong class="v3-dimension-status" data-dimension-status="approximate">Approximate dimensions</strong> use the best available estimate. <strong class="v3-dimension-status" data-dimension-status="unknown">Dimensions unknown</strong> use an adjustable display size.</p>
    </div>
    <div class="v3-spatial-feature__works">
      {arVrFeatured.map((work) => <V3WorkCard work={work} displayTitle={work.slug === 'laocoon' ? 'Laocoön and His Sons' : undefined} spatial={true} />)}
    </div>
  </section>

  <section class="v3-section v3-section--line" aria-labelledby="wings-home-title">
    <div class="v3-section-head v3-section-head--split">
      <div>
        <p class="v3-kicker">03 / Wings</p>
        <h2 id="wings-home-title" class="v3-display">A permanent place for every work.</h2>
      </div>
      <a href={withBase('/wings/')}>All wings →</a>
    </div>
    <V3WingGrid compact={true} />
  </section>

  {pairings.length > 0 && (
  <section class="v3-section v3-section--line" aria-labelledby="pairs-title">
    <div class="v3-section-head">
      <p class="v3-kicker">04 / Comparisons</p>
      <h2 id="pairs-title" class="v3-display">Two works, considered together.</h2>
    </div>
    <div class="v3-pairs">
      {pairings.map((pair) => (
        <div class="v3-pair v3-reveal">
          <a class="v3-pair__img v3-float v3-float--soft" href={withBase(v3WorkRoute(pair.a))} aria-label={pair.a.title}>
            <img src={withBase(pair.a.thumbnailImage)} alt={pair.a.title} width="720" height="900" loading="lazy" decoding="async" />
          </a>
          <div class="v3-pair__copy">
            <p class="v3-kicker">{pair.title}</p>
            <p class="v3-wall">{pair.line}</p>
            <p class="v3-pair__works">
              <b>{pair.a.title}</b> · {pair.a.displayDate}<br />
              <b>{pair.b.title}</b> · {pair.b.displayDate}
            </p>
          </div>
          <a class="v3-pair__img v3-float v3-float--soft" href={withBase(v3WorkRoute(pair.b))} aria-label={pair.b.title}>
            <img src={withBase(pair.b.thumbnailImage)} alt={pair.b.title} width="720" height="900" loading="lazy" decoding="async" />
          </a>
        </div>
      ))}
    </div>
  </section>
  )}

  <section class="v3-section v3-section--line" aria-labelledby="exhibitions-home-title">
    <div class="v3-section-head v3-section-head--split">
      <div>
        <p class="v3-kicker">05 / Exhibitions</p>
        <h2 id="exhibitions-home-title" class="v3-display">Guided ways through the collection.</h2>
      </div>
      <a href={withBase('/exhibitions/')}>All exhibitions →</a>
    </div>

    <div class="v3-exlist">
      {exhibitions.map((exhibition) => (
        <a class="v3-exrow" href={withBase(v3ExhibitionRoute(exhibition))} style={`--ex-accent:${exhibition.accent}`}>
          <span class="v3-exrow__no">{exhibition.number}</span>
          <div>
            <p class="v3-exrow__kicker">{exhibition.kicker}</p>
            <h3>{exhibition.title}</h3>
          </div>
          <p class="v3-exrow__summary">{exhibition.summary}</p>
          <span class="v3-exrow__img v3-float"><img src={withBase(exhibitionFeaturedWork(exhibition).thumbnailImage)} alt="" width="240" height="300" loading="lazy" decoding="async" /></span>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </div>
  </section>


  <section class="v3-section v3-random" aria-labelledby="random-title">
    <p class="v3-kicker">06 / Random selection</p>
    <h2 id="random-title">Choose a work at random.</h2>
    <p>A different starting point can change what you notice.</p>
    <a class="v3-random__button" href={randomRoutes[0]} data-random-work>Choose a work <span>↗</span></a>
  </section>

  <script define:vars={{ randomRoutes }}>
    const randomLink = document.querySelector('[data-random-work]');
    randomLink?.addEventListener('click', (event) => {
      event.preventDefault();
      const next = randomRoutes[Math.floor(Math.random() * randomRoutes.length)];
      window.location.href = next;
    });
  </script>
</V3Layout>
