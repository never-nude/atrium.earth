---
type Props = { label: { title: string; period?: string; region?: string; maker?: string; material?: string } };
const { label } = Astro.props;
const facts = [['Time period', label.period], ['Region', label.region], ['Material', label.material]].filter(([, value]) => value);
---
<section class="artwork-label" aria-label="Artwork label" data-artwork-label>
  <h3 class="artwork-label-title">{label.title}</h3>
  {label.maker && <p class="artwork-label-maker"><span class="artwork-label-sr">Maker: </span>{label.maker}</p>}
  {facts.length > 0 && <dl class="artwork-label-facts">{facts.map(([name, value]) => <div><dt class="artwork-label-sr">{name}</dt><dd>{value}</dd></div>)}</dl>}
</section>
<style>
  .artwork-label { box-sizing: border-box; padding: 14px 16px; border: 1px solid var(--v3-line, rgba(247,245,239,.16)); border-left: 2px solid var(--v3-signal, #eccf7a); border-radius: 3px; color: var(--v3-ink, #f7f5ef); background: rgba(14,22,38,.88); font-family: var(--v3-sans, "Inter", "Helvetica Neue", Arial, sans-serif); overflow-wrap: anywhere; text-align: left; }
  .artwork-label-title { margin: 0; color: inherit; font-size: 18px; line-height: 1.3; letter-spacing: -.025em; font-weight: 500; }
  .artwork-label-maker { margin: 5px 0 0; font-size: 12px; line-height: 1.4; }
  .artwork-label-facts { display: flex; flex-wrap: wrap; gap: 0 5px; margin: 5px 0 0; color: var(--v3-muted, #c9c6bd); font-size: 12px; line-height: 1.4; }
  .artwork-label-facts > div { display: contents; }
  .artwork-label-facts > div + div::before { content: '·'; }
  .artwork-label-facts dd { display: inline; margin: 0; }
  .artwork-label-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
