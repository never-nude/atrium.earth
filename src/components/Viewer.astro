---
import SpatialViewing from './SpatialViewing.astro';
import previewStills from '../data/viewer-stills.json';
type Props = {
  glb?: string;
  modelBytes?: number;
  poster: string;
  /** Alt text for the still image. Describe the work itself; the default only names it. */
  posterAlt?: string;
  title: string;
  hud?: boolean;
  tag?: string;
  upAxis?: string;
  modelTransform?: Record<string, unknown>;
  materialAppearance?: Record<string, unknown>;
  immersive?: boolean;
  posterLoading?: 'eager' | 'lazy';
  autoStart?: boolean | 'visible';
  autoRotate?: boolean;
  autoRotateSpeed?: number;
  // Positive values turn the sculpture counterclockwise when viewed from above.
  turntableDegreesPerSecond?: number;
  respectReducedMotion?: boolean;
  rotationControl?: 'full' | 'simple';
  wheelZoom?: boolean;
  displayControls?: boolean;
  spatialViewing?: boolean;
  museumLabel?: Record<string, string>;
  spatialAssetSha256?: string;
  spatialDimensionStatus?: 'verified' | 'approximate' | 'unknown';
  spatialLabel?: string;
  spatialSizeLabel?: string;
  spatialDefaultMaxExtentMeters?: number;
  spatialUnavailableNote?: string;
  spatialReference?: { axis: string; meters: number; extentFraction?: number; estimated?: boolean } | null;
  spatialNote?: string;
  displaySupport?: { kind: string; height?: number; note: string } | null;
};
const {
  glb = '',
  modelBytes,
  poster,
  posterAlt,
  title,
  hud = true,
  tag,
  upAxis = 'auto',
  modelTransform = {},
  materialAppearance = {},
  immersive = false,
  posterLoading = 'lazy',
  autoStart = true,
  autoRotate = true,
  autoRotateSpeed,
  turntableDegreesPerSecond,
  respectReducedMotion = true,
  rotationControl = 'full',
  wheelZoom = true,
  displayControls = false,
  spatialViewing = false,
  museumLabel,
  spatialAssetSha256,
  spatialDimensionStatus = 'unknown',
  spatialLabel,
  spatialSizeLabel,
  spatialDefaultMaxExtentMeters,
  spatialUnavailableNote,
  spatialReference = null,
  spatialNote,
  displaySupport,
} = Astro.props;
const hasModel = Boolean(glb);
const uid = Math.random().toString(36).slice(2, 8);
const appearanceJson = JSON.stringify(materialAppearance);
const thumbnailSlug = /\/previews\/renders\/(.+)\/thumb\.webp$/.exec(poster)?.[1];
const renderedStill = hasModel && thumbnailSlug && previewStills.includes(thumbnailSlug) ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/viewer-stills/${thumbnailSlug}.webp` : '';
const backdrop = ['backdropTop', 'backdropBase', 'backdropGlow'].map(key => {
  const value = materialAppearance[key];
  return typeof value === 'string' && /^#[a-f\d]{6}$/i.test(value) ? value : undefined;
});
const glowStrength = Number(materialAppearance.backdropGlowStrength ?? 0.07);
const stageBackdrop = hasModel ? [
  `--stage-top:${backdrop[0] ?? '#15243a'}`,
  `--stage-base:${backdrop[1] ?? '#15243a'}`,
  `--stage-glow:${backdrop[2] ?? '#d7dee8'}`,
  `--stage-glow-strength:${Number.isFinite(glowStrength) ? Math.max(0, Math.min(glowStrength, 1)) * 100 : 7}%`,
].join(';') : undefined;
const transformJson = JSON.stringify(modelTransform);
const manual = autoStart === false && hasModel;
const sizeLabel = modelBytes && modelBytes > 0 ? ` · ${(modelBytes / 1e6).toFixed(1)} MB` : '';
---

<div class:list={['viewer', { 'viewer--immersive': immersive }]} data-viewer data-auto-start={String(autoStart)} data-viewer-state={hasModel ? 'idle' : undefined} data-model-bytes={modelBytes} data-wheel-zoom={String(wheelZoom)}>
  <div class="model-stage" data-stage style={stageBackdrop} data-rendered-still={renderedStill ? true : undefined} data-glb={hasModel ? glb : ''} data-spatial-asset-sha256={spatialViewing ? spatialAssetSha256 : undefined} data-up-axis={upAxis} data-model-transform={transformJson} data-material-appearance={appearanceJson} data-immersive={String(immersive)} data-auto-rotate={String(autoRotate)} data-auto-rotate-speed={autoRotateSpeed} data-turntable-degrees-per-second={turntableDegreesPerSecond} data-respect-reduced-motion={respectReducedMotion ? undefined : 'false'} data-rotation-control={rotationControl === 'simple' ? 'simple' : undefined} tabindex={hasModel ? '0' : undefined} aria-label={hasModel ? `Interactive 3D view of ${title}` : undefined} aria-describedby={hasModel ? `viewer-keys-${uid}` : undefined}>
    <span class="stage-corner stage-corner--tl" aria-hidden="true"></span>
    <span class="stage-corner stage-corner--tr" aria-hidden="true"></span>
    <span class="stage-corner stage-corner--bl" aria-hidden="true"></span>
    <span class="stage-corner stage-corner--br" aria-hidden="true"></span>
    <span class="stage-tag" aria-hidden="true">{tag ?? (hasModel ? '3D MODEL' : 'PHOTOGRAPH')}</span>

    <img src={renderedStill || poster} data-fallback-poster={renderedStill ? poster : undefined} alt={posterAlt ?? `${title} — still image`} width="720" height="900" loading={posterLoading} decoding="async" data-poster />
    {manual && <div class="viewer-download" aria-hidden="true"><span data-download-bar></span></div>}

    {/* Rendered hidden: the script reveals it only when it is needed (auto-start
        off, or the model failed to load). Crawlers, pre-hydration paint, and
        no-JS visitors all get the still image with nothing offered on top of it. */}
    {hasModel && !manual && (
      <button class="stage-activate" type="button" data-activate aria-describedby={`viewer-status-${uid}`} hidden>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 2 4 6.5v9L12 20l8-4.5v-9L12 2z" />
          <path d="M4 6.5 12 11l8-4.5M12 11v9" />
        </svg>
        <span data-activate-label>Examine in 3D</span>
      </button>
    )}
    {!manual && <div class="stage-loading" data-loading aria-hidden="true" hidden>
      <span class="spinner" aria-hidden="true"></span>
      <span class="loading-text">Loading…</span>
    </div>}
    {hasModel && !manual && <p id={`viewer-status-${uid}`} class="viewer-keyboard-instructions viewer-status" data-viewer-status role="status" aria-atomic="true"></p>}

    {hasModel && (
      <div class="immersive-tools" data-immersive-tools hidden role="group" aria-label="3D viewing tools">
        {immersive && <>
          <button type="button" data-zoom-in aria-label="Zoom in" title="Zoom in">+</button>
          <button type="button" data-zoom-out aria-label="Zoom out" title="Zoom out">−</button>
        </>}
        <button type="button" data-tool-wire aria-pressed="false" title="Show the 3D model’s triangle edges">Wireframe</button>
        <button type="button" data-tool-rotate aria-pressed={String(autoRotate)} title="Start or pause automatic rotation">Auto-rotate</button>
        <button type="button" data-tool-fullscreen aria-pressed="false" title="Enter full screen">Full screen</button>
      </div>
    )}

    {immersive && hasModel && displayControls && (
      <details class="immersive-light" data-display-controls hidden>
        <summary>Display <span>+</span></summary>
        <div class="immersive-light__panel" aria-label="Display controls">
          <label>Exposure <input type="range" min="5" max="120" step="1" value="20" data-exposure /></label>
          <div class="immersive-texture">
            <div class="immersive-texture__label">
              <label for={`texture-${uid}`}>Texture</label>
              <button type="button" data-texture-reset aria-label="Restore original texture" disabled>Reset</button>
            </div>
            <input id={`texture-${uid}`} type="range" min="0" max="100" step="1" value="50" data-surface-texture />
          </div>
        </div>
      </details>
    )}
  </div>

  {manual && <div class="viewer-start" data-viewer-start hidden>
    <button class="viewer-start__button" type="button" data-activate aria-describedby={`viewer-status-${uid}`} hidden>
      <span data-activate-label>Examine in 3D{sizeLabel}</span>
    </button>
    <span data-download-label data-loading hidden aria-hidden="true">Loading 3D</span>
    <p id={`viewer-status-${uid}`} class="viewer-keyboard-instructions viewer-start__status" data-viewer-status role="status" aria-atomic="true"></p>
    <p class="viewer-handling-feedback" data-handling-feedback role="status" aria-atomic="true"></p>
  </div>}

  {hud && hasModel && (
    <div class="viewer-hud" data-hud-panel hidden>
      <div class="hud-control">
        <label for={`b-${uid}`}>Exposure <span class="hud-read" data-read-brightness>20%</span></label>
        <input id={`b-${uid}`} type="range" min="5" max="120" step="1" value="20" data-brightness />
      </div>
      <div class="hud-control">
        <label for={`r-${uid}`}>Texture <span class="hud-ends">rough → shiny</span></label>
        <input id={`r-${uid}`} type="range" min="0" max="100" step="1" value="20" data-texture />
      </div>
    </div>
  )}

  {hasModel && <p class="stage-hint fine" data-hint hidden>Drag to turn the view · <span class="stage-hint__pan">right-drag or two-finger drag to move the view · </span>{wheelZoom && 'scroll or pinch to zoom · '}double-click or double-tap to reset</p>}
  {hasModel && <p id={`viewer-keys-${uid}`} class="viewer-keyboard-instructions">After opening the 3D view, focus the sculpture and use arrow keys to turn, plus and minus to zoom, and 0 or Home to reset. {manual && 'Press Enter or Space to pause or resume handling.'}</p>}

  {spatialViewing && hasModel && <SpatialViewing title={title} poster={poster} museumLabel={museumLabel} reference={spatialReference} sizeNote={spatialNote} displaySupport={displaySupport} dimensionStatus={spatialDimensionStatus} requiresAssetCheck={Boolean(spatialAssetSha256)} referenceLabel={spatialLabel} sizeLabel={spatialSizeLabel} defaultMaxExtentMeters={spatialDefaultMaxExtentMeters} />}
  {!spatialViewing && spatialUnavailableNote && <a id="ar-vr" class="spatial-unavailable" data-spatial-unavailable href="#size-verification" title={spatialUnavailableNote}>AR / VR unavailable · Size unverified <span aria-hidden="true">↓</span></a>}

  <noscript>
    {/* Without JavaScript the still image is the presentation, not a fallback: hide
        every affordance that promises an interaction the page cannot deliver. */}
    <style is:inline>
      .viewer .stage-tag, .viewer .stage-activate, .viewer .stage-loading, .viewer .stage-hint { display: none !important; }
    </style>
  </noscript>
</div>

<script>
  import { rememberSpatialAppearance } from '../lib/spatial-materials.mjs';
  import { createTextureControl } from '../lib/viewerTexture';
  import { createViewerRenderLoop, bindViewerRenderEvents } from '../lib/viewer-render-loop.mjs';
  import { bindViewerInput, bindViewerReset, bindViewerZoom, handleViewerKey, orbitViewer } from '../lib/viewer-input.mjs';
  import { fetchViewerModel } from '../lib/viewer-download.mjs';
  import { disposeViewerScene } from '../lib/viewer-resources.mjs';

  type ViewState = {
    position: number[];
    target: number[];
    autoRotate: boolean;
    wireframe: boolean;
    turntableAngle?: number;
  };

  type Viewer = {
    spatial: any;
    setVisible: (visible: boolean) => void;
    capture: () => ViewState;
    dispose: () => void;
    setBrightness: (pct: number) => void;
    setTexture: (pct: number) => void;
    setWireframe: (on: boolean) => void;
    setAutoRotate: (on: boolean) => void;
    rotationState: () => { active: boolean; reduced: boolean };
    orbit: (horizontal: number, vertical: number) => void;
    invalidate: () => void;
    zoom: (factor: number) => void;
    reset: () => void;
    handling?: ReturnType<typeof bindViewerInput>;
    texture: ReturnType<typeof createTextureControl>;
    defaults: { exposure: number; texture: number; autoRotate: boolean };
  };

  type Appearance = {
    key?: string;
    baseColor: string;
    secondaryColor: string;
    tintStrength: number;
    variation: number;
    metalness: number;
    roughness: number;
    textureDefault: number;
    exposure: number;
    envMapIntensity: number;
    emissiveIntensity?: number;
    mapLift?: number;
    mapFloor?: number;
    keyLightIntensity?: number;
    fillLightIntensity?: number;
    rimLightIntensity?: number;
    hemiLightIntensity?: number;
    sourceVertexColors?: 'ignore-invalid';
    preserveSourceUnlit?: boolean;
    preserveSourceMaterials?: boolean;
  };

  const WIREFRAME_COLOR = 0xE3DAC9;

  const defaultAppearance: Appearance = {
    baseColor: '#9F9689',
    secondaryColor: '#7A7268',
    tintStrength: 0.1,
    variation: 0.12,
    metalness: 0,
    roughness: 0.68,
    textureDefault: 34,
    exposure: 0.66,
    envMapIntensity: 0.18,
    emissiveIntensity: 0,
    mapLift: 0.16,
    mapFloor: 0.05,
    keyLightIntensity: 1.12,
    fillLightIntensity: 0.88,
    rimLightIntensity: 1.16,
    hemiLightIntensity: 0.82,
  };

  function readAppearance(stage: HTMLElement): Appearance {
    try {
      return { ...defaultAppearance, ...JSON.parse(stage.dataset.materialAppearance || '{}') };
    } catch {
      return defaultAppearance;
    }
  }

  function clamp01(value: number) {
    return Math.max(0, Math.min(1, value));
  }

  function noise01(value: number) {
    const s = Math.sin(value * 12.9898) * 43758.5453;
    return s - Math.floor(s);
  }

  function hasAuthoredVertexColors(mesh: any) {
    return Boolean(mesh.geometry?.attributes?.color && !mesh.geometry.userData.atriumPaletteBase);
  }

  function addMaterialVariation(THREE: any, mesh: any, material: any, appearance: Appearance) {
    if (hasAuthoredVertexColors(mesh)) return;
    const position = mesh.geometry?.attributes?.position;
    if (!position || position.count > 850000) return;

    if (!mesh.geometry.attributes.color) mesh.geometry = mesh.geometry.clone();
    const colors = new Float32Array(position.count * 3);
    const base = new THREE.Color(appearance.baseColor);
    const secondary = new THREE.Color(appearance.secondaryColor || appearance.baseColor);
    const seed = noise01((mesh.name || material.name || 'atrium').length * 17.17);

    for (let i = 0; i < position.count; i += 1) {
      const x = position.getX(i), y = position.getY(i), z = position.getZ(i);
      const grain = noise01(x * 37.1 + y * 51.7 + z * 73.3 + seed * 19.9);
      const vertical = clamp01((y + 0.5) * 0.75);
      const mix = clamp01(grain * appearance.variation + vertical * appearance.variation * 0.45);
      const color = base.clone().lerp(secondary, mix);
      const shade = 1 - appearance.variation * 0.28 + grain * appearance.variation * 0.42;
      color.multiplyScalar(shade);
      colors[i * 3] = color.r;
      colors[i * 3 + 1] = color.g;
      colors[i * 3 + 2] = color.b;
    }

    mesh.geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    mesh.geometry.userData.atriumPaletteBase = appearance.baseColor;
    material.vertexColors = true;
  }

  function prepareMaterial(THREE: any, source: any, appearance?: Appearance) {
    if (appearance?.preserveSourceMaterials === true) return source;
    if (appearance?.preserveSourceUnlit === true && source.isMeshBasicMaterial) return source;
    if ('roughness' in source && 'metalness' in source && 'emissive' in source) return source;
    const prepared = new THREE.MeshStandardMaterial({
      name: source.name || 'atrium-material',
      map: source.map || null,
      normalMap: source.normalMap || null,
      aoMap: source.aoMap || null,
      alphaMap: source.alphaMap || null,
      transparent: source.transparent || false,
      opacity: source.opacity ?? 1,
      side: source.side,
      vertexColors: source.vertexColors || false,
      color: source.color ? source.color.clone() : new THREE.Color(0xffffff),
    });
    prepared.needsUpdate = true;
    return prepared;
  }

  function createWireframeMaterial(THREE: any, source: any) {
    return new THREE.MeshBasicMaterial({
      color: WIREFRAME_COLOR,
      wireframe: true,
      side: source.side,
    });
  }

  function applyMapLift(THREE: any, material: any, appearance: Appearance) {
    const mapLift = appearance.mapLift || 0;
    const mapFloor = appearance.mapFloor || 0;
    if (!material.map || (!mapLift && !mapFloor)) return;
    const liftColor = new THREE.Color(appearance.secondaryColor || appearance.baseColor);
    material.onBeforeCompile = (shader: any) => {
      shader.uniforms.atriumMapLift = { value: mapLift };
      shader.uniforms.atriumMapFloor = { value: mapFloor };
      shader.uniforms.atriumMapLiftColor = { value: liftColor };
      shader.fragmentShader = `
uniform float atriumMapLift;
uniform float atriumMapFloor;
uniform vec3 atriumMapLiftColor;
${shader.fragmentShader.replace('#include <map_fragment>', `
#include <map_fragment>
#ifdef USE_MAP
  diffuseColor.rgb = mix(diffuseColor.rgb, atriumMapLiftColor, atriumMapLift);
  float atriumLuma = dot(diffuseColor.rgb, vec3(0.2126, 0.7152, 0.0722));
  if (atriumLuma < atriumMapFloor) {
    diffuseColor.rgb *= atriumMapFloor / max(atriumLuma, 0.001);
  }
#endif
`)}`;
    };
    material.customProgramCacheKey = () => `atrium-map-lift-${mapLift}-${mapFloor}-${liftColor.getHexString()}`;
  }

  function hasSourceTexture(material: any) {
    return Boolean(
      material.map
      || material.normalMap
      || material.aoMap
      || material.alphaMap
      || material.emissiveMap
      || material.metalnessMap
      || material.roughnessMap
      || material.bumpMap
      || material.displacementMap
    );
  }

  function applyMaterialAppearance(THREE: any, mesh: any, material: any, appearance: Appearance) {
    if (appearance.preserveSourceMaterials === true) return;
    if (!('color' in material)) return;
    // Explicit, evidence-backed per-work decision; retain the source attribute
    // and material multiplier, and never replace it with a generated palette.
    if (appearance.sourceVertexColors === 'ignore-invalid' && hasAuthoredVertexColors(mesh)) {
      material.vertexColors = false;
    }
    if (hasSourceTexture(material) || hasAuthoredVertexColors(mesh)) {
      if ('envMapIntensity' in material && material.envMapIntensity == null) {
        material.envMapIntensity = appearance.envMapIntensity;
      }
      material.needsUpdate = true;
      return;
    }

    rememberSpatialAppearance(material, appearance);
    const target = new THREE.Color(appearance.baseColor);
    material.color.lerp(target, appearance.tintStrength);
    if ('metalness' in material) material.metalness = appearance.metalness;
    if ('roughness' in material) material.roughness = appearance.roughness;
    if ('envMapIntensity' in material) material.envMapIntensity = appearance.envMapIntensity;
    if ('emissive' in material && appearance.emissiveIntensity) {
      material.emissive.lerp(target, 0.72);
      material.emissiveIntensity = appearance.emissiveIntensity;
    }
    applyMapLift(THREE, material, appearance);
    addMaterialVariation(THREE, mesh, material, appearance);
    material.needsUpdate = true;
  }

  async function buildViewer(root: HTMLElement, stage: HTMLElement, glb: string, build: {
    saved?: ViewState;
    signal: AbortSignal;
    isVisible: () => boolean;
    onFirstFrame: () => void;
    onHandlingChange?: (active: boolean) => void;
    onProgress?: (progress: { loadedBytes: number; totalBytes: number | null }) => void;
  }): Promise<Viewer> {
    const { saved, signal, isVisible, onFirstFrame, onHandlingChange, onProgress } = build;
    const THREE = await import('three');
    const { DRACOLoader } = await import('three/examples/jsm/loaders/DRACOLoader.js');
    const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
    const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
    const { RoomEnvironment } = await import('three/examples/jsm/environments/RoomEnvironment.js');
    const { MeshoptDecoder } = await import('three/examples/jsm/libs/meshopt_decoder.module.js');
    const { applyModelTransform, frameCameraToBox, normalizeModel, parseModelTransform } = await import(`${import.meta.env.BASE_URL}model-render-utils.js`);
    signal.throwIfAborted();
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const respectReducedMotion = stage.dataset.respectReducedMotion !== 'false';

    let width = stage.clientWidth || 600;
    let height = stage.clientHeight || 600;
    const appearance = readAppearance(stage);
    const immersive = stage.dataset.immersive === 'true';

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    let suspended = false;
    let contextLost = false;
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = appearance.exposure;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.domElement.classList.add('viewer-canvas');
    stage.appendChild(renderer.domElement);
    function reportRenderError(reason: string) {
      root.dispatchEvent(new CustomEvent('atrium:viewer-render-error', { detail: { reason } }));
    }
    renderer.domElement.addEventListener('webglcontextlost', event => {
      event.preventDefault();
      contextLost = true;
      if (!suspended) reportRenderError('context-lost');
    }, { signal });

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, width / height, immersive ? 0.001 : 0.01, 200);

    const pmrem = new THREE.PMREMGenerator(renderer);
    const room = new RoomEnvironment();
    const environment = pmrem.fromScene(room, 0.04);
    scene.environment = environment.texture;
    room.dispose();
    pmrem.dispose();

    // Keep the gallery rig spectrally neutral: authored base-colour, normal and
    // PBR maps supply the object's colour and surface character. The lights only
    // reveal form, and their direction is fixed rather than visitor-controlled.
    scene.add(new THREE.HemisphereLight(0xffffff, 0x606060, appearance.hemiLightIntensity ?? 0.7));
    const key = new THREE.DirectionalLight(0xffffff, appearance.keyLightIntensity ?? 2.4);
    const keyRadius = 5, keyHeight = 4;
    const fixedKeyAngle = 0.15 * Math.PI * 2;
    key.position.set(Math.cos(fixedKeyAngle) * keyRadius, keyHeight, Math.sin(fixedKeyAngle) * keyRadius);
    key.castShadow = true;
    key.shadow.mapSize.set(1024, 1024);
    key.shadow.bias = -0.0005;
    key.shadow.normalBias = 0.015;
    scene.add(key);
    const fill = new THREE.DirectionalLight(0xffffff, appearance.fillLightIntensity ?? 0.55);
    fill.position.set(-3, 1.2, -2.5);
    scene.add(fill);
    const rim = new THREE.DirectionalLight(0xffffff, appearance.rimLightIntensity ?? 0.4);
    rim.position.set(-2.7, 2.6, 3.4);
    scene.add(rim);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.zoomSpeed = immersive ? 1.35 : 0.8;
    controls.mouseButtons = { LEFT: THREE.MOUSE.ROTATE, MIDDLE: THREE.MOUSE.DOLLY, RIGHT: THREE.MOUSE.PAN };
    controls.rotateSpeed = 0.9;
    controls.enablePan = true;
    controls.enableZoom = root.dataset.wheelZoom !== 'false';
    const turntableSpeed = Number(stage.dataset.turntableDegreesPerSecond || 0);
    const turnsModel = Number.isFinite(turntableSpeed) && turntableSpeed !== 0;
    let rotationRequested = saved?.autoRotate ?? (stage.dataset.autoRotate !== 'false');
    let handling: Viewer['handling'];
    const rotationState = () => ({ active: rotationRequested && !(respectReducedMotion && reducedMotion.matches), reduced: respectReducedMotion && reducedMotion.matches });
    const rotationRunning = () => rotationState().active && (handling?.isActive() ?? true);
    controls.autoRotate = !turnsModel && rotationRunning();
    const timedRotation = stage.dataset.autoRotateSpeed !== undefined;
    const rotationSpeed = Number(stage.dataset.autoRotateSpeed ?? 1);
    controls.autoRotateSpeed = Number.isFinite(rotationSpeed) && rotationSpeed >= 0 ? rotationSpeed : 1;

    const loader = new GLTFLoader();
    loader.setMeshoptDecoder(MeshoptDecoder);
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath(`${import.meta.env.BASE_URL}vendor/draco/`);
    loader.setDRACOLoader(dracoLoader);
    let gltf: any;
    let pendingReleased = false;
    const releasePending = () => {
      if (pendingReleased) return;
      pendingReleased = true;
      if (gltf?.scene) disposeViewerScene(gltf.scene);
      controls.dispose();
      environment.dispose();
      renderer.dispose();
      renderer.forceContextLoss();
      renderer.domElement.remove();
    };
    signal.addEventListener('abort', releasePending, { once: true });
    let verifiedAsset = false;
    try {
      const bytes = await fetchViewerModel(glb, { signal, expectedBytes: Number(root.dataset.modelBytes), onProgress });
      if (stage.dataset.spatialAssetSha256) {
        // Verify the bytes actually displayed, including models with mutable URLs.
        // A mismatch keeps ordinary 3D available while preventing an AR launch.
        if (crypto.subtle) {
          try {
            const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', bytes));
            verifiedAsset = Array.from(digest, value => value.toString(16).padStart(2, '0')).join('') === stage.dataset.spatialAssetSha256;
          } catch {
            // A browser unable to verify the model can still offer ordinary 3D.
            verifiedAsset = false;
          }
        }
      }
      signal.throwIfAborted();
      gltf = await loader.parseAsync(bytes, new URL('.', new URL(glb, location.href)).href);
      if (signal.aborted) { disposeViewerScene(gltf.scene); signal.throwIfAborted(); }
    } catch (error) {
      signal.removeEventListener('abort', releasePending);
      if (!signal.aborted) releasePending();
      throw error;
    } finally {
      dracoLoader.dispose();
    }
    signal.throwIfAborted();
    const model = gltf.scene;
    const transform = parseModelTransform(stage.dataset.modelTransform || stage.dataset.upAxis || 'auto', stage.dataset.upAxis || 'auto');

    const scanHelpers: any[] = [];
    const materials: any[] = [];
    const wireframeMeshes: any[] = [];
    model.traverse((obj: any) => {
      const elementCount = obj.geometry?.index?.count || obj.geometry?.getAttribute?.('position')?.count || 0;
      const tinyCube = /^cube(?:_|\.|$)/i.test(obj.name || '') && elementCount / 3 <= 12;
      if (/^(?:cubo|disco)(?:_|\.|$)/i.test(obj.name || '') || /^(?:cubo|disco)(?:_|\.|$)/i.test(obj.material?.name || '') || tinyCube) {
        scanHelpers.push(obj);
        return;
      }
      if (obj.isMesh && obj.material) {
        if (!obj.geometry?.getAttribute('normal')) {
          obj.geometry = obj.geometry.clone();
          obj.geometry.computeVertexNormals();
        }
        // The scan's authored maps carry its surface colour and texture. The
        // fixed neutral key may ground its geometry, but the object never receives
        // a synthetic shadow from another mesh in the viewer.
        obj.castShadow = true;
        obj.receiveShadow = false;
        const hasMaterialArray = Array.isArray(obj.material);
        const list = hasMaterialArray ? obj.material : [obj.material];
        const prepared = list.map((m: any) => prepareMaterial(THREE, m, appearance));
        const wireframes = prepared.map((m: any) => createWireframeMaterial(THREE, m));
        const solidMaterial = hasMaterialArray ? prepared : prepared[0];
        const wireframeMaterial = hasMaterialArray ? wireframes : wireframes[0];
        obj.material = solidMaterial;
        wireframeMeshes.push({ mesh: obj, solidMaterial, wireframeMaterial });
        for (const m of prepared) {
          applyMaterialAppearance(THREE, obj, m, appearance);
          materials.push(m);
        }
      }
    });
    for (const helper of scanHelpers) helper.parent?.remove(helper);

    applyModelTransform(THREE, model, transform);
    const normalized = normalizeModel(THREE, model);
    const box = normalized.box;
    const size = normalized.size;
    // normalizeModel positions the scan around world origin. Rotate a wrapper so
    // the scan's original origin cannot move the sculpture off its base.
    const turntable = new THREE.Group();
    if (turnsModel) {
      turntable.add(model);
      turntable.rotation.y = saved?.turntableAngle ?? 0;
      scene.add(turntable);
    } else scene.add(model);

    // Keep the shadow camera close to the normalized object. A modest map and
    // PCF filtering produce a soft grounding shadow without painting detail onto
    // the object's authored texture.
    const shadowSpan = Math.max(size.x, size.y, size.z) * 2.2;
    const keyDist = Math.hypot(keyRadius, keyHeight);
    const shadowCam = key.shadow.camera;
    shadowCam.left = -shadowSpan;
    shadowCam.right = shadowSpan;
    shadowCam.top = shadowSpan;
    shadowCam.bottom = -shadowSpan;
    shadowCam.near = Math.max(0.1, keyDist - shadowSpan);
    shadowCam.far = keyDist + shadowSpan;
    shadowCam.updateProjectionMatrix();

    const isWideLow = Math.max(size.x, size.z) > Math.max(size.y * 1.8, 0.65);
    camera.near = immersive ? 0.001 : 0.01;
    camera.far = 100;
    frameCameraToBox(THREE, camera, box, {
      direction: transform.viewDirection || [0.55, 0.34, 0.9],
      padding: transform.fit || (isWideLow ? 1.38 : 1.18),
    });
    controls.target.set(0, 0, 0);
    controls.minDistance = immersive ? 0.035 : 0.5;
    controls.maxDistance = immersive ? 24 : 8;
    controls.update(timedRotation ? 0 : undefined);

    const grid = new THREE.GridHelper(4, 24, 0x3a557a, 0x22324a);
    grid.position.y = -size.y / 2 - 0.001;
    (grid.material as any).transparent = true;
    (grid.material as any).opacity = 0.18;
    grid.visible = false;
    scene.add(grid);

    // A low-opacity neutral receiver grounds the object without tinting the
    // backdrop or competing with texture and material maps.
    const shadowFoot = Math.max(1.2, Math.max(size.x, size.z) * 4);
    const ground = new THREE.Mesh(
      new THREE.PlaneGeometry(shadowFoot, shadowFoot),
      new THREE.ShadowMaterial({ color: 0x000000, opacity: 0.16, depthWrite: false }),
    );
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = -size.y / 2 + 0.001;
    ground.receiveShadow = true;
    scene.add(ground);

    const home = { pos: camera.position.clone(), tgt: controls.target.clone() };
    let wireframe = saved?.wireframe ?? false;
    if (saved) {
      camera.position.fromArray(saved.position);
      controls.target.fromArray(saved.target);
      controls.autoRotate = !turnsModel && rotationRunning();
      for (const item of wireframeMeshes) item.mesh.material = wireframe ? item.wireframeMaterial : item.solidMaterial;
      controls.update(timedRotation ? 0 : undefined);
    }

    let disposed = false;
    const renderEvents = new AbortController();
    const loop = createViewerRenderLoop({ visible: isVisible(), hidden: document.hidden,
      onError: () => reportRenderError('render'),
      onFirstFrame: () => {
        if (renderer.getContext().isContextLost()) reportRenderError('context-lost');
        else {
          if (onHandlingChange) {
            handling = bindViewerInput({
              canvas: renderer.domElement, controls, signal,
              wheelZoom: root.dataset.wheelZoom !== 'false',
              onToggle: active => { syncRotation(); onHandlingChange(active); },
              onReset: resetView,
            });
            bindViewerZoom({
              canvas: renderer.domElement, signal,
              canHandle: () => controls.enabled && Boolean(handling?.isActive()),
              onZoom: zoomView,
            });
          } else bindViewerReset(renderer.domElement, resetView, signal);
          onFirstFrame();
        }
      },
      draw: (elapsed: number) => {
        // The featured sculpture turns independently of orbit-control interaction state.
        // Use elapsed time so a slow device does not turn it into a nearly still image.
        if (turnsModel && rotationRunning()) {
          turntable.rotation.y = (turntable.rotation.y + THREE.MathUtils.degToRad(turntableSpeed) * Math.min(elapsed, 1)) % (Math.PI * 2);
        }
        const changed = controls.update(timedRotation ? Math.min(elapsed, 0.1) : undefined);
        renderer.render(scene, camera);
        return rotationRunning() || changed;
      },
    });
    const invalidate = () => loop.invalidate();
    function zoomView(factor: number) {
      const offset = camera.position.clone().sub(controls.target);
      const distance = Math.max(controls.minDistance, Math.min(controls.maxDistance, offset.length() * factor));
      offset.setLength(distance);
      camera.position.copy(controls.target).add(offset);
      controls.update(timedRotation ? 0 : undefined);
      invalidate();
    }
    function resetView() {
      // Flush any remaining drag damping before restoring the authored view.
      controls.enableDamping = false;
      controls.autoRotate = false;
      controls.update(0);
      turntable.rotation.y = 0;
      camera.position.copy(home.pos);
      controls.target.copy(home.tgt);
      controls.update(0);
      controls.enableDamping = true;
      controls.autoRotate = !turnsModel && rotationRunning();
      invalidate();
    }

    function resize() {
      if (suspended) return;
      width = stage.clientWidth || width; height = stage.clientHeight || height;
      renderer.setSize(width, height); camera.aspect = width / height; camera.updateProjectionMatrix();
      invalidate();
    }
    const ro = new ResizeObserver(resize);
    ro.observe(stage);
    function syncRotation() {
      const state = rotationState();
      controls.autoRotate = !turnsModel && rotationRunning();
      stage.closest('[data-viewer]')?.dispatchEvent(new CustomEvent('atrium:viewer-rotation-change', { detail: state }));
      invalidate();
    }
    bindViewerRenderEvents({ loop, controls, media: reducedMotion, onMotionChange: syncRotation, signal: renderEvents.signal });
    loop.invalidate();

    // Pending cleanup owns initialization; later render failures restore the poster.
    const textureControl = createTextureControl(materials);
    signal.removeEventListener('abort', releasePending);
    return {
      spatial: {
        THREE, renderer, scene, camera, model, ground, grid, box, verifiedAsset,
        suspend: () => {
          if (suspended || disposed) throw new Error('Finish the current view before starting another.');
          suspended = true;
          loop.setSuspended(true);
          const controlsEnabled = controls.enabled;
          controls.enabled = false;
          return () => {
            if (disposed) return;
            suspended = false;
            controls.enabled = controlsEnabled;
            if (contextLost) {
              queueMicrotask(() => { if (!disposed) reportRenderError('context-lost'); });
              return;
            }
            resize();
            loop.setSuspended(false);
          };
        },
      },
      setVisible: (next) => loop.setVisible(next),
      capture: () => ({ position: camera.position.toArray(), target: controls.target.toArray(), autoRotate: rotationRequested, wireframe, turntableAngle: turntable.rotation.y }),
      dispose: () => {
        if (disposed) return;
        disposed = true;
        loop.destroy();
        renderEvents.abort();
        ro.disconnect();
        controls.dispose();
        disposeViewerScene(scene, wireframeMeshes.flatMap(item => [item.solidMaterial, item.wireframeMaterial]));
        key.shadow.dispose();
        environment.dispose();
        renderer.dispose();
        renderer.forceContextLoss();
        renderer.domElement.remove();
      },
      texture: { ...textureControl, setValue: (value) => { textureControl.setValue(value); invalidate(); } },
      invalidate,
      rotationState,
      orbit: (horizontal, vertical) => { orbitViewer(THREE, camera, controls, horizontal, vertical); controls.update(timedRotation ? 0 : undefined); invalidate(); },
      setBrightness: (pct) => { renderer.toneMappingExposure = pct / 100; invalidate(); },
      // Slider runs rough (0) → shiny (100); roughness is the inverse.
      setTexture: (pct) => { if (appearance.preserveSourceMaterials === true) textureControl.setValue(pct); else { const r = 1 - pct / 100; for (const m of materials) { m.roughness = r; m.needsUpdate = true; } } invalidate(); },
      setWireframe: (on) => { wireframe = on; for (const item of wireframeMeshes) item.mesh.material = on ? item.wireframeMaterial : item.solidMaterial; invalidate(); },
      setAutoRotate: (on) => { rotationRequested = on; syncRotation(); },
      zoom: zoomView,
      reset: resetView,
      get handling() { return handling; },
      defaults: { exposure: Math.round(appearance.exposure * 100), texture: appearance.preserveSourceMaterials === true ? textureControl.defaultValue : appearance.textureDefault, get autoRotate() { return rotationState().active; } },
    };
  }

  function bindViewerFullscreen(root: HTMLElement, button: HTMLButtonElement, signal: AbortSignal) {
    const native = () => document.fullscreenElement === root;
    const overlay = () => root.hasAttribute('data-viewer-expanded');
    function syncButton() {
      const expanded = native() || overlay();
      button.setAttribute('aria-pressed', String(expanded));
      button.textContent = expanded ? 'Exit full screen' : 'Full screen';
    }
    const inerted: HTMLElement[] = [];
    function showOverlay() {
      root.setAttribute('data-viewer-expanded', '');
      root.setAttribute('role', 'dialog');
      root.setAttribute('aria-modal', 'true');
      root.setAttribute('aria-label', 'Full-screen sculpture');
      // Leave the viewer in place so its running canvas and AR dialog keep their state.
      for (let child = root; child.parentElement && child !== document.body; child = child.parentElement) {
        for (const sibling of child.parentElement.children) {
          if (sibling !== child && sibling instanceof HTMLElement && !sibling.inert) {
            sibling.inert = true;
            inerted.push(sibling);
          }
        }
      }
      syncButton();
      button.focus({ preventScroll: true });
    }
    function closeOverlay() {
      if (!overlay()) return;
      root.removeAttribute('data-viewer-expanded');
      root.removeAttribute('role');
      root.removeAttribute('aria-modal');
      root.removeAttribute('aria-label');
      for (const sibling of inerted.splice(0)) sibling.inert = false;
      syncButton();
      if (!signal.aborted) button.focus({ preventScroll: true });
    }
    button.addEventListener('click', async () => {
      if (overlay()) { closeOverlay(); return; }
      if (native()) { await document.exitFullscreen().catch(() => {}); return; }
      if (document.fullscreenEnabled && root.requestFullscreen) {
        try {
          await root.requestFullscreen();
          if (signal.aborted && native()) await document.exitFullscreen().catch(() => {});
          return;
        } catch { /* An embedded or mobile browser can refuse native fullscreen. */ }
      }
      if (!signal.aborted) showOverlay();
    }, { signal });
    document.addEventListener('fullscreenchange', syncButton, { signal });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !event.defaultPrevented && overlay() && !root.querySelector('dialog[open]')) {
        event.preventDefault();
        closeOverlay();
      }
    }, { signal });
    signal.addEventListener('abort', () => {
      closeOverlay();
      if (native()) void document.exitFullscreen().catch(() => {});
    }, { once: true });
    syncButton();
  }

  // Exhibition pages can contain many models. Keep four nearby/recent viewers,
  // including in-flight loads; retain the visitor's camera when an old one is released.
  const residents = new Map<Element, { visible: () => boolean; release: () => void }>();
  function trimResidents() {
    for (const [element, resident] of residents) {
      if (residents.size <= 4) break;
      if (resident.visible() || document.fullscreenElement === element || (element as HTMLElement).hasAttribute('data-viewer-expanded') || element.contains(document.activeElement)) continue;
      resident.release();
    }
  }

  let pageSuspended = false;
  const mountedViewers = new Map<HTMLElement, { dispose: () => void; refresh: () => void }>();
  function mountViewer(root: HTMLElement) {
    if (mountedViewers.has(root) || !root.isConnected || root.ownerDocument !== document) return;
    const stage = root.querySelector('[data-stage]') as HTMLElement | null;
    const glb = stage?.getAttribute('data-glb') || '';
    if (!stage || !glb) return;
    const lifetime = new AbortController();
    const poster = root.querySelector<HTMLImageElement>('[data-poster]');
    const fallbackPoster = () => {
      if (!poster?.dataset.fallbackPoster) return;
      const fallback = poster.dataset.fallbackPoster;
      delete poster.dataset.fallbackPoster;
      stage?.removeAttribute('data-rendered-still');
      poster.src = fallback;
    };
    const loading = root.querySelector('[data-loading]') as HTMLElement | null;
    const activate = root.querySelector('[data-activate]') as HTMLButtonElement | null;
    const activateLabel = root.querySelector('[data-activate-label]');
    const status = root.querySelector('[data-viewer-status]');
    const hud = root.querySelector('[data-hud-panel]') as HTMLElement | null;
    const tools = root.querySelector('[data-immersive-tools]') as HTMLElement | null;
    const displayPanel = root.querySelector('[data-display-controls]') as HTMLElement | null;
    const hint = root.querySelector('[data-hint]') as HTMLElement | null;
    const downloadLabel = root.querySelector('[data-download-label]');
    const startStrip = root.querySelector<HTMLElement>('[data-viewer-start]');
    const handlingFeedback = root.querySelector<HTMLElement>('[data-handling-feedback]');
    const downloadBar = root.querySelector<HTMLElement>('[data-download-bar]');
    const fullscreenButton = root.querySelector<HTMLButtonElement>('[data-tool-fullscreen]');
    // Opening a collection miniature is already an explicit activation in its parent page.
    if (poster?.complete && !poster.naturalWidth) fallbackPoster();
    poster?.addEventListener('error', fallbackPoster, { signal: lifetime.signal });
    const startMode = document.documentElement.classList.contains('studio-peek') ? 'true' : root.dataset.autoStart;
    const lazy = startMode === 'visible' && 'IntersectionObserver' in window;
    const size = Number(root.dataset.modelBytes) || 0;
    const examineLabel = startMode === 'false' && size ? `Examine in 3D · ${(size / 1e6).toFixed(1)} MB` : 'Examine in 3D';
    const announceState = (state: string) => {
      root.dataset.viewerState = state;
      if (startStrip) startStrip.hidden = startMode !== 'false';
    };
    const intersectsViewport = () => {
      const rect = stage!.getBoundingClientRect();
      return rect.width > 0 && rect.height > 0 && rect.bottom > 0 && rect.top < window.innerHeight && rect.right > 0 && rect.left < window.innerWidth;
    };
    let visible = intersectsViewport();
    let activeViewer: Viewer | undefined;
    let saved: ViewState | undefined;
    let bindings: AbortController | undefined;
    let hintTimer: number | undefined;
    let feedbackTimer: number | undefined;
    let generation = 0;
    let started = false;
    let autoStartReady = false;
    let startTimer: number | undefined;
    let idleCallback: number | undefined;
    let visibilityObserver: IntersectionObserver | undefined;
    let preloadObserver: IntersectionObserver | undefined;
    function clearHandlingFeedback() {
      window.clearTimeout(feedbackTimer);
      if (handlingFeedback) handlingFeedback.textContent = '';
    }
    function showHandlingFeedback(active: boolean) {
      clearHandlingFeedback();
      root.dataset.handling = active ? 'active' : 'paused';
      if (!handlingFeedback) return;
      handlingFeedback.textContent = active ? '3D controls on' : '3D controls paused';
      feedbackTimer = window.setTimeout(clearHandlingFeedback, 2400);
    }

    function release() {
      generation += 1;
      if (activeViewer) saved = activeViewer.capture();
      bindings?.abort();
      activeViewer?.dispose();
      activeViewer = undefined;
      window.clearTimeout(hintTimer);
      clearHandlingFeedback();
      delete root.dataset.handling;
      stage!.classList.remove('is-live');
      for (const element of [loading, tools, displayPanel, hud, hint]) if (element) element.hidden = true;
      downloadBar?.style.removeProperty('width');
      if (poster) poster.style.opacity = '1';
      if (activate) activate.hidden = false;
      if (activateLabel) activateLabel.textContent = examineLabel;
      if (status) status.textContent = '';
      root.removeAttribute('aria-busy');
      announceState('idle');
      residents.delete(root);
      started = false;
    }

    function fail(reason: string) {
      if (!started) return;
      const restoreFocus = root.contains(document.activeElement) && !root.querySelector('dialog[open]');
      release();
      announceState('error');
      if (activateLabel) activateLabel.textContent = 'Retry 3D';
      if (status) status.textContent = 'The 3D view could not load. The still image is available.';
      if (restoreFocus) activate?.focus({ preventScroll: true });
      root.dispatchEvent(new CustomEvent('atrium:viewer-error', { detail: { reason } }));
    }

    function startAutomatically() {
      if (root.dataset.viewerState !== 'error') void start();
    }

    async function start() {
      if (started || lifetime.signal.aborted || pageSuspended) return; started = true;
      const current = ++generation;
      const events = new AbortController();
      bindings = events;
      residents.delete(root);
      residents.set(root, { visible: () => visible, release });
      trimResidents();
      if (current !== generation || events.signal.aborted) return;
      const moveFocus = activate !== null && document.activeElement === activate;
      if (activate) activate.hidden = true;
      if (moveFocus) stage!.focus({ preventScroll: true });
      announceState('loading');
      root.setAttribute('aria-busy', 'true');
      if (status) status.textContent = moveFocus ? 'Loading the 3D view.' : '';
      if (loading) loading.hidden = false;
      if (downloadLabel) downloadLabel.textContent = size ? `Loading 3D · 0.0 of ${(size / 1e6).toFixed(1)} MB` : 'Loading 3D';
      try {
        const viewer = await buildViewer(root, stage!, glb, {
          saved, signal: events.signal, isVisible: () => visible && !pageSuspended,
          onHandlingChange: startMode === 'false' ? showHandlingFeedback : undefined,
          onProgress: downloadLabel ? (progress) => {
            if (current !== generation || events.signal.aborted) return;
            const loaded = (progress.loadedBytes / 1e6).toFixed(1);
            const total = progress.totalBytes ? (progress.totalBytes / 1e6).toFixed(1) : null;
            const label = `Loading 3D · ${loaded}${total === null ? '' : ` of ${total}`} MB`;
            if (downloadLabel.textContent !== label) downloadLabel.textContent = label;
            if (downloadBar) downloadBar.style.width = progress.totalBytes
              ? `${Math.floor(Math.min(100, progress.loadedBytes / progress.totalBytes * 100))}%`
              : '';
          } : undefined,
          onFirstFrame: () => {
            if (current !== generation || events.signal.aborted) return;
            stage!.classList.add('is-live');
            if (poster) poster.style.opacity = '0';
            if (loading) loading.hidden = true;
            for (const element of [tools, displayPanel, hud, hint]) if (element) element.hidden = false;
            if (status) status.textContent = moveFocus ? '3D view ready.' : '';
            if (hint) {
              hint.classList.remove('is-dismissed');
              hintTimer = window.setTimeout(() => hint.classList.add('is-dismissed'), 7000);
            }
            root.removeAttribute('aria-busy');
            announceState('ready');
            if (startMode === 'false') showHandlingFeedback(true);
          },
        });
        if (current !== generation) { viewer.dispose(); return; }
        activeViewer = viewer;
        viewer.setVisible(visible && !pageSuspended);
        function on<K extends keyof HTMLElementEventMap>(target: HTMLElement | Document | null, type: K, listener: (event: HTMLElementEventMap[K]) => void) {
          target?.addEventListener(type, listener as EventListener, { signal: events.signal });
        }
        let wireOn = saved?.wireframe ?? false;
        const syncWire = () => {
          root.querySelector('[data-tool-wire]')?.setAttribute('aria-pressed', String(wireOn));
        };
        on(stage!, 'keydown', event => {
          if (event.target === stage && (event.key === 'Enter' || event.key === ' ') && viewer.handling) {
            event.preventDefault();
            if (!event.repeat) viewer.handling.setActive(!viewer.handling.isActive());
            return;
          }
          if (viewer.handling && !viewer.handling.isActive()) return;
          handleViewerKey(event, {
            orbit: (horizontal: number, vertical: number) => viewer.orbit(horizontal, vertical),
            zoom: (factor: number) => viewer.zoom(factor), reset: () => viewer.reset(),
            toggleWireframe: () => { wireOn = !wireOn; viewer.setWireframe(wireOn); syncWire(); },
          });
        });
        if (fullscreenButton) bindViewerFullscreen(root, fullscreenButton, events.signal);
        if (hint) {
          // Show the gesture hint once, then let it get out of the way: it fades after
          // a beat, or as soon as the visitor starts handling the model. Only canvas
          // pointerdowns count — toolbar taps bubble through the stage and must not eat it.
          const dismissHint = () => hint.classList.add('is-dismissed');
          on(stage!, 'pointerdown', (event) => {
            if (event.target instanceof Element && event.target.classList.contains('viewer-canvas')) dismissHint();
          });
        }
        if (tools) {
          const zoomIn = tools.querySelector('[data-zoom-in]') as HTMLButtonElement | null;
          const zoomOut = tools.querySelector('[data-zoom-out]') as HTMLButtonElement | null;
          const wire = tools.querySelector('[data-tool-wire]') as HTMLButtonElement | null;
          const rotate = tools.querySelector('[data-tool-rotate]') as HTMLButtonElement | null;
          syncWire();
          const syncRotationButton = () => {
            const state = viewer.rotationState();
            const rotateOn = state.active;
            if (!rotate) return;
            rotate.disabled = state.reduced;
            rotate.title = 'Start or pause automatic rotation';
            if (stage?.dataset.rotationControl === 'simple') {
              rotate.removeAttribute('aria-pressed');
              const action = rotateOn ? 'Pause' : 'Resume';
              rotate.textContent = action;
              rotate.setAttribute('aria-label', `${action} rotation`);
              rotate.title = `${action} rotation`;
            } else {
              rotate.setAttribute('aria-pressed', String(rotateOn));
            }
            if (state.reduced) rotate.title = 'Automatic rotation is paused by your reduced-motion preference';
          };
          syncRotationButton();
          on(root, 'atrium:viewer-rotation-change' as any, syncRotationButton);
          on(zoomIn, 'click', () => viewer.zoom(0.68));
          on(zoomOut, 'click', () => viewer.zoom(1.46));
          on(wire, 'click', () => {
            wireOn = !wireOn;
            viewer.setWireframe(wireOn);
            syncWire();
          });
          on(rotate, 'click', () => {
            viewer.setAutoRotate(!viewer.rotationState().active);
          });
        }
        if (displayPanel) {
          const exposure = displayPanel.querySelector('[data-exposure]') as HTMLInputElement | null;
