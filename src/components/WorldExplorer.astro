---
import { withBase } from '../lib/urls';
import { worldPayloadUrl } from '../lib/world-payload';
import WorldViewControls from './WorldViewControls.astro';
type Props = { compact?: boolean; instanceId?: string };
const {compact=false, instanceId=compact ? 'home-world' : 'world'} = Astro.props;
const Heading = compact ? 'h2' : 'h1';
const Subheading = compact ? 'h3' : 'h2';
---
  <section id={compact ? 'explore-the-world' : undefined} class:list={['world-page', {'world-page--compact':compact}]} data-world-explorer data-world-compact={compact ? '' : undefined} data-world-data-url={worldPayloadUrl} data-world-detail-url={withBase('/world/')} aria-labelledby={`${instanceId}-title`}>
    <header class="world-heading">
      <div><p class="world-eyebrow">Atrium / Place &amp; time</p><Heading id={`${instanceId}-title`} data-world-title>A world of art.</Heading><p>Turn the globe. Choose a place. Travel through time.</p></div>
      {compact ? <a href={withBase('/world/')} data-world-continue>Open full explorer <span aria-hidden="true">↗</span></a> : <a href={withBase('/wings/')}>Explore the museum wings <span aria-hidden="true">↗</span></a>}
    </header>

    <div class="world-layout">
      <section class="world-observatory" aria-label="Explore documented origins">
        <div class="world-viewport" data-world-viewport>
        <div class="world-map-toolbar">
          <div class="world-mode" aria-label="Map presentation"><button type="button" data-world-mode="globe" aria-pressed="true">Globe</button><button type="button" data-world-mode="map" aria-pressed="false">Map</button></div>
          <button class="world-reset" type="button" data-world-reset>Reset exploration <span aria-hidden="true">↺</span></button>
        </div>
        <div class="world-globe" data-world-globe data-land-url={withBase('/world/land.geo.json')} aria-label="Interactive globe of documented artwork origins">
          <p class="world-loading" data-world-loading>Bringing the world into view…</p>
        </div>
        <WorldViewControls />
        </div>
        <div class="world-map-caption"><span data-world-map-hint>Drag to turn · Select a glowing place</span><span>Country and regional locations are approximate.</span></div>
        <ul class="world-legend" aria-label="Origin colors">
          <li style="--region:#00e5ff">Europe</li><li style="--region:#ff6b5f">Africa</li><li style="--region:#ffd34e">Asia</li><li style="--region:#ff4fce">Americas</li><li style="--region:#59f5c5">Oceania</li><li style="--region:#a98bff">Across regions</li>
        </ul>

        <section class="world-time" aria-labelledby={`${instanceId}-time-title`}>
          <div class="world-time-heading"><div><p class="world-eyebrow" id={`${instanceId}-time-title`}>Time</p><Subheading data-world-period>All periods</Subheading></div><a href={`#${instanceId}-results`} data-world-period-count></a></div>
          <div class="world-time-range" data-world-range>
            <div class="world-time-track"><span data-world-range-fill></span></div>
            <label class="sr-only" for={`${instanceId}-from`}>Earliest date</label><input id={`${instanceId}-from`} type="range" min="0" max="1000" step="any" value="0" data-world-from aria-describedby={`${instanceId}-time-help`} />
            <label class="sr-only" for={`${instanceId}-to`}>Latest date</label><input id={`${instanceId}-to`} type="range" min="0" max="1000" step="any" value="1000" data-world-to aria-describedby={`${instanceId}-time-help`} />
          </div>
          <div class="world-time-ticks" data-world-ticks aria-hidden="true"></div>
          <div class="world-time-foot"><p id={`${instanceId}-time-help`}>Move either end to explore a period. Earlier time is compressed.</p><details class="world-exact"><summary>Exact dates</summary><form data-world-date-form><label>From<input type="text" data-world-date-from placeholder="500 BCE" autocomplete="off" /></label><label>To<input type="text" data-world-date-to placeholder="1500 CE" autocomplete="off" /></label><button type="submit">Apply dates</button><p data-world-date-error role="status"></p></form></details></div>
        </section>
      </section>

      <aside id={`${instanceId}-results`} class="world-results" aria-labelledby={`${instanceId}-results-title`}>
        <div class="world-results-heading"><p class="world-eyebrow">Discover the collection</p><Subheading id={`${instanceId}-results-title`} data-world-place-title>Across the world</Subheading><p data-world-result-count aria-live="polite" aria-atomic="true"></p></div>
        <label class="world-place-select">Choose a place<select data-world-place aria-label="Choose an origin"><option value="">All recorded origins</option></select></label>
        <p class="world-origin-note" data-world-origin-note></p>
        <p class="world-shown-count" data-world-shown-count></p><div class="world-work-list" data-world-works></div>
        <button class="world-more" type="button" data-world-more hidden>Show more works <span aria-hidden="true">↓</span></button>
        <p class="world-empty" data-world-empty hidden>No documented works match this selection. Widen the dates or choose another place.</p>
        <p class="world-uncertainty" data-world-uncertainty></p>
        {compact ? <a class="world-all-works world-continue" href={withBase('/world/')} data-world-continue>Continue exploring the world <span aria-hidden="true">→</span></a> : <a class="world-all-works" href={withBase('/collection/')}>Explore the complete collection <span aria-hidden="true">↗</span></a>}
      </aside>
    </div>

    {!compact && <footer class="world-context"><p>The globe follows documented origins, rather than the museums or archives that hold the works. Broad or uncertain records remain available in the collection.</p><p>Wings bring together works by historical tradition and geography. The globe offers another way to explore their documented origins.</p><a href={withBase('/wings/')}>Visit the six wings <span aria-hidden="true">→</span></a></footer>}
    <noscript><p class="world-no-script">The interactive globe needs JavaScript. <a href={withBase('/collection/')}>Browse every work in the collection</a> or <a href={withBase('/wings/')}>visit the museum wings</a>.</p></noscript>
  </section>
  <script>import '../scripts/world-explorer.js';</script>
<style>
  .world-page { --world-cyan:#48e6ff; --world-ink:#f1f8ff; --world-muted:#aabbd0; color:var(--world-ink); background:radial-gradient(ellipse at 23% 29%,#102f484d,transparent 48%),radial-gradient(ellipse at 69% 40%,#56134d30,transparent 42%),#050a14; min-height:80vh; padding:36px var(--v3-pad) 54px; }
  .world-heading { display:flex; justify-content:space-between; align-items:end; gap:24px; max-width:1560px; margin:0 auto 25px; }
  .world-eyebrow { margin:0 0 10px; color:#82c5d7; font:500 10px/1.5 var(--v3-sans); letter-spacing:.14em; text-transform:uppercase; }
  .world-heading [data-world-title] { margin:0 0 12px; font-size:clamp(36px,4.4vw,64px); line-height:1.03; font-weight:500; letter-spacing:-.05em; }
  .world-heading > div > p:last-child { margin:0; color:var(--world-muted); font-size:14px; line-height:1.7; }
  .world-heading > a,.world-context a { color:var(--world-cyan); font-size:12px; text-underline-offset:5px; line-height:1.6; }
  .world-layout { display:grid; grid-template-columns:minmax(0,1.9fr) minmax(280px,1fr); gap:24px; max-width:1560px; margin:auto; align-items:start; }
  .world-observatory { position:relative; min-width:0; overflow:hidden; border:1px solid #46dbff29; background:radial-gradient(ellipse at 50% 39%,#12335e4d,transparent 63%),#060d1b; box-shadow:0 0 70px #117fa50c; }
  .world-map-toolbar { display:flex; justify-content:space-between; gap:14px; align-items:center; padding:14px 18px 0; position:relative; z-index:4; }
  .world-mode { display:flex; gap:3px; padding:3px; border:1px solid #54cee633; border-radius:6px; background:#0a1428; }
  .world-mode button,.world-reset { min-height:38px; padding:8px 13px; border:0; background:transparent; color:var(--world-muted); cursor:pointer; font:500 11px/1.5 var(--v3-sans); border-radius:4px; }
  .world-mode button[aria-pressed="true"] { color:#09121e; background:var(--world-cyan); box-shadow:0 0 17px #48e6ff24; }
  .world-reset { color:#b7c8dc; padding-right:0; }
  .world-reset span { margin-left:7px; color:var(--world-cyan); font-size:17px; }
  .world-globe { position:relative; width:100%; height:clamp(360px,44vw,590px); min-height:360px; }
  .world-globe :global(canvas) { display:block; max-width:100%; }
  .world-viewport { display:flex; flex-direction:column; }
  .world-viewport:fullscreen { width:100%; height:100%; background:#050b17; }
  .world-viewport:fullscreen .world-globe { flex:1; height:auto; min-height:0; }
  .world-loading { position:absolute; inset:45% 15px auto; margin:0; text-align:center; color:#8eb6ce; font-size:12px; letter-spacing:.04em; }
  .world-map-caption { display:flex; justify-content:space-between; flex-wrap:wrap; gap:7px 15px; padding:0 22px 16px; color:#829cb6; font-size:10px; line-height:1.6; }
  .world-legend { display:flex; justify-content:center; flex-wrap:wrap; gap:9px 22px; margin:0; padding:0 18px 21px; list-style:none; }
  .world-legend li { display:flex; gap:7px; align-items:center; font-size:10px; color:#b5c8db; }
  .world-legend li::before { content:''; width:5px; height:5px; border-radius:50%; background:var(--region); box-shadow:0 0 9px var(--region); }
  .world-time { padding:20px 24px 15px; border-top:1px solid #46dbff29; background:linear-gradient(120deg,#0c1d314d,#1c0f284d); }
  .world-time-heading { display:flex; gap:15px; justify-content:space-between; align-items:end; margin-bottom:13px; }
  .world-time-heading .world-eyebrow { margin-bottom:5px; }
  .world-time [data-world-period] { margin:0; font-size:20px; font-weight:500; line-height:1.4; letter-spacing:-.02em; }
  .world-time-heading > a { color:#8eabc4; font-size:10px; text-align:right; line-height:1.5; text-underline-offset:4px; }
  .world-time-range { position:relative; height:36px; margin:0 8px; }
  .world-time-track { position:absolute; top:16px; left:0; right:0; height:3px; background:#22334b; }
  .world-time-track > span { position:absolute; height:3px; left:0; width:100%; background:linear-gradient(90deg,#48e6ff,#ca75ff); box-shadow:0 0 12px #48e6ff50; }
  .world-time-range input { position:absolute; inset:0; width:100%; height:36px; margin:0; appearance:none; -webkit-appearance:none; background:transparent; pointer-events:none; }
  .world-time-range input:focus-visible { outline:1px solid #48e6ff; outline-offset:5px; border-radius:3px; z-index:3; }
  .world-time-range input::-webkit-slider-thumb { appearance:none; -webkit-appearance:none; width:24px; height:28px; border:2px solid #a9f7ff; background:#0e2638; border-radius:4px; box-shadow:0 0 14px #48e6ff54; pointer-events:auto; cursor:ew-resize; }
  .world-time-range input::-moz-range-thumb { width:20px; height:24px; border:2px solid #a9f7ff; background:#0e2638; border-radius:4px; pointer-events:auto; cursor:ew-resize; }
  .world-time-ticks { position:relative; height:20px; margin-inline:8px; color:#7f98b0; font-size:9px; line-height:1.5; }
  .world-time-ticks :global(span) { position:absolute; top:0; white-space:nowrap; }
  .world-time-foot { display:flex; flex-wrap:wrap; justify-content:space-between; gap:7px 15px; margin-top:12px; }
  .world-time-foot > p { margin:0; color:#7f98b0; font-size:10px; line-height:1.7; }
  .world-exact { color:#adbfce; font-size:10px; }
  .world-exact summary { cursor:pointer; min-height:30px; }
  .world-exact form { display:flex; align-items:end; gap:8px; flex-wrap:wrap; padding:8px 0; }
  .world-exact label { display:grid; gap:5px; }
  .world-exact input { min-width:0; width:110px; padding:9px; color:#eef8ff; background:#08111f; border:1px solid #44647c; border-radius:3px; }
  .world-exact button { min-height:36px; color:#07121b; background:#6ddff4; border:0; padding:8px 12px; border-radius:3px; cursor:pointer; }
  .world-exact form > p { flex-basis:100%; margin:0; color:#ffb39c; }
  .world-results { min-width:0; padding:24px; border:1px solid #71648b3d; background:linear-gradient(145deg,#101b2ad9,#0c101cd9); scroll-margin-top:85px; }
  .world-results-heading [data-world-place-title] { margin:0 0 9px; font-size:30px; font-weight:500; letter-spacing:-.035em; line-height:1.16; }
  .world-results-heading > p:last-child { margin:0 0 21px; color:#b1c2d4; font-size:12px; line-height:1.6; }
  .world-place-select { display:grid; gap:7px; margin-bottom:12px; color:#93aac0; font-size:10px; }
  .world-place-select select { min-width:0; width:100%; min-height:42px; padding:9px 11px; border:1px solid #46d8ee3b; border-radius:5px; color:#e3f8ff; background:#091422; font:12px var(--v3-sans); }
  .world-origin-note { margin:0 0 19px; color:#8eabc4; font-size:11px; line-height:1.7; }
  .world-shown-count { margin:0 0 12px; color:#93abc0; font-size:10px; line-height:1.5; }
  .world-work-list { display:grid; gap:18px; }
  .world-work-list :global(.world-work) { display:grid; grid-template-columns:105px minmax(0,1fr); gap:15px; padding-top:17px; border-top:1px solid #9bc2dc22; text-decoration:none; color:#eaf4ff; }
  .world-work-list :global(.world-work img) { display:block; width:105px; height:128px; object-fit:contain; background:#17283f; }
  .world-work-list :global(.world-work [data-world-work-title]) { margin:0 0 7px; font-size:16px; font-weight:500; line-height:1.3; letter-spacing:-.015em; }
  .world-work-list :global(.world-work p) { margin:0 0 7px; color:#91a9bf; font-size:10px; line-height:1.6; }
  .world-work-list :global(.world-work span) { display:inline-flex; min-height:30px; align-items:center; gap:10px; color:#69e7ff; font-size:10px; }
  .world-work-list :global(.world-work:hover [data-world-work-title]) { color:#80edff; }
  .world-more { display:flex; justify-content:space-between; align-items:center; width:100%; min-height:42px; margin-top:22px; padding:10px 12px; color:#9eebff; background:#0d2130; border:1px solid #48e6ff44; border-radius:5px; cursor:pointer; font-size:11px; }
  .world-empty,.world-uncertainty { color:#8da5bc; font-size:11px; line-height:1.8; }
  .world-all-works { display:inline-flex; align-items:center; gap:12px; margin-top:14px; min-height:38px; color:#8fe8fc; font-size:11px; text-underline-offset:4px; }
  .world-context { max-width:1560px; display:grid; grid-template-columns:1fr 1fr auto; gap:25px; margin:25px auto 0; align-items:start; }
  .world-context p { margin:0; color:#829bb2; font-size:11px; line-height:1.8; }
  .world-no-script { color:#bed8e6; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media(max-width:1000px) { .world-layout { grid-template-columns:minmax(0,1.45fr) minmax(250px,1fr); gap:16px; } .world-page { padding-inline:24px; } .world-results { padding:18px; } .world-work-list :global(.world-work) { grid-template-columns:80px minmax(0,1fr); gap:11px; } .world-work-list :global(.world-work img) { width:80px; height:100px; } .world-context { grid-template-columns:1fr 1fr; } .world-heading > a { max-width:160px; } }
  @media(max-width:760px) { .world-page { padding:28px 16px 40px; } .world-heading { display:block; margin-bottom:22px; } .world-heading > a { display:inline-block; max-width:none; margin-top:16px; font-size:11px; } .world-layout { grid-template-columns:1fr; } .world-globe { height:390px; min-height:300px; } .world-time { padding:17px 18px 12px; } .world-map-toolbar { padding:12px 13px 0; } .world-reset { font-size:10px; } .world-map-caption { padding-inline:18px; } .world-legend { gap:8px 16px; } .world-context { grid-template-columns:1fr; gap:13px; } .world-results-heading [data-world-place-title] { font-size:27px; } .world-work-list :global(.world-work) { grid-template-columns:100px minmax(0,1fr); } .world-work-list :global(.world-work img) { width:100px; height:120px; } .world-time [data-world-period] { font-size:18px; } }
  @media(prefers-reduced-motion:reduce) { .world-page * { scroll-behavior:auto; } }

  .world-page--compact { min-height:0; margin-bottom:56px; padding:28px; border:1px solid #46dbff29; }
  .world-page--compact .world-heading { margin-bottom:22px; }
  .world-page--compact .world-heading [data-world-title] { font-size:clamp(30px,3.7vw,48px); }
  .world-page--compact .world-heading > div > p:last-child { font-size:13px; }
  .world-page--compact .world-layout { grid-template-columns:minmax(0,1.65fr) minmax(260px,1fr); gap:18px; }
  .world-page--compact .world-globe { height:clamp(300px,29vw,390px); min-height:300px; }
  .world-page--compact .world-results { padding:20px; }
  .world-page--compact .world-results-heading [data-world-place-title] { font-size:26px; }
  .world-page--compact .world-work-list :global(.world-work) { grid-template-columns:76px minmax(0,1fr); gap:12px; }
  .world-page--compact .world-work-list :global(.world-work img) { width:76px; height:96px; }
  .world-page--compact .world-work-list :global(.world-work [data-world-work-title]) { font-size:14px; }
  .world-page--compact .world-work-list :global(.world-work p) { margin-bottom:5px; }
  .world-page--compact .world-map-caption { padding:0 16px 13px; }
  .world-page--compact .world-legend { gap:8px 14px; padding-bottom:16px; }
  .world-page--compact .world-time { padding:17px 18px 12px; }
  .world-page--compact .world-time [data-world-period] { font-size:18px; }
  .world-page--compact .world-continue { margin-top:16px; padding:9px 12px; border:1px solid #48e6ff44; border-radius:4px; background:#0d2130; text-decoration:none; }
  @media(max-width:1000px) { .world-page--compact { padding:22px; } .world-page--compact .world-layout { grid-template-columns:minmax(0,1.4fr) minmax(235px,1fr); gap:14px; } .world-page--compact .world-results { padding:16px; } }
  @media(max-width:760px) { .world-page--compact { padding:22px 14px; margin-bottom:40px; } .world-page--compact .world-layout { grid-template-columns:1fr; } .world-page--compact .world-globe { height:320px; } .world-page--compact .world-heading > a { margin-top:12px; } }
  @media(max-width:400px) { .world-page--compact .world-map-toolbar { flex-wrap:wrap; gap:4px; padding-inline:10px; } .world-page--compact .world-mode button { padding-inline:10px; } .world-page--compact .world-reset { margin-left:auto; } }
</style>
