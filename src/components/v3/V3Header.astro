---
import { withBase } from '../../lib/urls';

type Props = { currentPath: string };
const { currentPath } = Astro.props;
const nav = [
  ['Explore', '/v3/collection/'],
  ['Exhibitions', '/v3/exhibitions/'],
];
const current = (href: string) => currentPath === href || (href !== '/v3/' && currentPath.startsWith(href));
---

<header class="v3-header" data-v3-header>
  <a class="v3-brand" href={withBase('/v3/')} aria-label="Atrium v3 home">
    <span>Atrium</span><sup>Earth</sup><em>V3 Preview</em>
  </a>

  <nav class="v3-nav" aria-label="Primary">
    {nav.map(([label, href]) => (
      <a href={withBase(href)} aria-current={current(href) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>

  <details class="v3-menu">
    <summary aria-label="Open menu"><span>Menu</span><i aria-hidden="true"></i></summary>
    <nav aria-label="Mobile primary">
      <a href={withBase('/v3/')}>Home</a>
      {nav.map(([label, href]) => <a href={withBase(href)}>{label}</a>)}
    </nav>
  </details>
</header>

<script>
  const header = document.querySelector('[data-v3-header]');
  let lastY = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    header?.classList.toggle('is-compact', y > 36);
    header?.classList.toggle('is-hidden', y > lastY && y > 180);
    lastY = y;
  }, { passive: true });
</script>
