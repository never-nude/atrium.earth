---
import type { Work } from '../../lib/catalog';
import { publicDataset } from '../../lib/catalog';
import { v3WorkRoute } from '../../lib/v3';
import { withBase } from '../../lib/urls';

type Props = { work: Work; eager?: boolean; stop?: number; spatial?: boolean };
const { work, eager = false, stop, spatial = false } = Astro.props;
const data = publicDataset(work);
const detail = [work.maker || work.culture, work.displayDate].filter(Boolean).join(' · ');
const alt = `${work.title}${detail ? ` — ${detail}` : ''}`;
const spatialAccess = work.spatialAccess?.enabled ? work.spatialAccess : null;
---

<article
  class="v3-card"
  data-v3-card
  data-search={data.search}
  data-year={data.year}
  data-wing={data.wing}
  data-era={data.era}
  data-place={data.place}
  data-material={data.material}
  data-maker={data.maker}
  data-size={spatialAccess ? (spatialAccess.verified ? 'verified' : 'unverified') : undefined}
>
  <a href={withBase(v3WorkRoute(work))}>
    <div class="v3-card__image v3-float" style={`view-transition-name: w-${work.id};`}>
      <img
        src={withBase(work.thumbnailImage)}
        alt={alt}
        width="720"
        height="900"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      {typeof stop === 'number' && <span class="v3-card__stop" aria-hidden="true">{String(stop).padStart(2, '0')}</span>}
    </div>
    <div class="v3-card__copy">
      <h3>{work.title}</h3>
      {detail && <p>{detail}</p>}
      {spatialAccess && (
        <div class:list={['v3-card__spatial-reference', { 'v3-card__spatial-reference--unverified': !spatialAccess.verified }]}>
          <span>{!spatial && 'AR / VR · '}{spatialAccess.label}</span>
          <span>{spatialAccess.sizeLabel}</span>
          {!spatialAccess.verified && <span class="v3-card__spatial-note">Chosen display size; actual dimensions unverified.</span>}
        </div>
      )}
    </div>
  </a>
  {spatial && spatialAccess && (
    <a class="v3-card__spatial-link" href={withBase(`${v3WorkRoute(work)}#ar-vr`)} aria-label={`View ${work.title} in AR or VR${spatialAccess.verified ? '' : ' — size unverified'}`}>
      View in AR / VR <span aria-hidden="true">↗</span>
    </a>
  )}
</article>
