---
import type { Work } from '../../lib/catalog';
import { publicDataset } from '../../lib/catalog';
import { v3WorkRoute } from '../../lib/v3';
import { withBase } from '../../lib/urls';
import { shortWorkTitle } from '../../lib/work-titles';

type Props = { work: Work; eager?: boolean; stop?: number; spatial?: boolean; displayTitle?: string; showViewKind?: boolean; exhibitionSlug?: string };
const { work, eager = false, stop, spatial = false, displayTitle = work.title, showViewKind = false, exhibitionSlug } = Astro.props;
const thumbnailTitle = shortWorkTitle(displayTitle);
const data = publicDataset(work);
const detail = [work.maker || work.culture, work.displayDate].filter(Boolean).join(' · ');
const alt = `${work.title}${detail ? ` — ${detail}` : ''}`;
const spatialAccess = work.spatialAccess?.enabled ? work.spatialAccess : null;
const previewBytes = work.modelBytes || undefined;
const detailHref = withBase(v3WorkRoute(work)) + (exhibitionSlug ? `?${new URLSearchParams({ exhibition: exhibitionSlug })}` : '');
---

<article
  class="v3-card"
  data-v3-card
  data-search={data.search}
  data-year={String(work.yearStart ?? '')}
  data-wing={data.wing}
  data-era={data.era}
  data-place={data.place}
  data-material={data.material}
  data-maker={data.maker}
  data-maker-label={work.maker || 'Maker not yet recorded'}
  data-size={spatialAccess?.status}
  data-studio-preview-bytes={previewBytes}
  data-studio-peek-available={String(work.hasPreview)}
  data-studio-index={work.index}
  data-studio-ingested={work.ingested || undefined}
>
  <a href={detailHref}>
    <div class="v3-card__image v3-float" style={`view-transition-name: w-${work.id};`}>
      <img
        src={withBase(work.thumbnailImage)}
        alt={alt}
        width="720"
        height="900"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      {typeof stop === 'number' && <span class="v3-card__stop" aria-hidden="true">{String(stop).padStart(2, '0')}</span>}
    </div>
    <div class="v3-card__copy">
      <h3>{thumbnailTitle}</h3>
      {detail && <p>{detail}</p>}
      {showViewKind && <p class="work-card-media">{work.hasPreview ? 'View in 3D' : 'Still image'}</p>}
    </div>
  </a>
  {spatial && spatialAccess && (
    <a class="v3-card__spatial-link" href={withBase(`${v3WorkRoute(work)}#ar-vr`)} aria-label={`View ${work.title} in AR or VR — ${spatialAccess.label}`}>
      View in AR / VR <span aria-hidden="true">↗</span>
    </a>
  )}
</article>

<style>
  .work-card-media { color: var(--v3-signal); margin-top: 6px; }
</style>
