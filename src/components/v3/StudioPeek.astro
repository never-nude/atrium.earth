<!-- Runs before deferred viewer scripts so static work pages can become miniatures. -->
<script is:inline>
  (() => {
    if (new URLSearchParams(location.search).get('studio-peek') !== '1' || window.parent === window) return;
    let sameOrigin = false;
    try { sameOrigin = window.parent.location.origin === location.origin; } catch { return; }
    if (!sameOrigin) return;
    const match = location.pathname.match(/\/works\/(.+?)\/?$/);
    if (!match) return;
    let work;
    try { work = decodeURIComponent(match[1]); } catch { return; }
    document.documentElement.classList.add('studio-peek');
    const send = type => window.parent.postMessage({ type, work }, location.origin);
    if (window.parent !== window.top) {
      document.documentElement.classList.add('studio-peek-unavailable');
      send('atrium-studio-peek-unavailable');
      return;
    }
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let nativeViewer = null;
    function stopMotion() {
      if (!nativeViewer || (!reduce.matches && !navigator.connection?.saveData)) return;
      const turn = nativeViewer.querySelector('[data-tool-rotate]');
      if (turn && (turn.getAttribute('aria-pressed') === 'true' || /^Pause\b/.test(turn.getAttribute('aria-label') || ''))) turn.click();
    }
    document.addEventListener('atrium:viewer-ready', event => {
      if (!(event.target instanceof Element) || !event.target.matches('#sculpture > [data-viewer]')) return;
      nativeViewer = event.target;
      // The native viewer binds its existing Turn control immediately after dispatch.
      // A microtask stops motion before the next animation frame without changing data.
      queueMicrotask(() => { stopMotion(); send('atrium-studio-peek-ready'); });
    }, true);
    document.addEventListener('atrium:viewer-error', event => {
      if (event.target instanceof Element && event.target.matches('#sculpture > [data-viewer]')) send('atrium-studio-peek-unavailable');
    }, true);
    reduce.addEventListener('change', stopMotion);
    navigator.connection?.addEventListener('change', stopMotion);
    document.addEventListener('DOMContentLoaded', () => {
      if (document.querySelectorAll('#sculpture > [data-viewer]').length !== 1 || !document.querySelector('#sculpture > [data-viewer] [data-stage][data-glb]:not([data-glb=""])')) send('atrium-studio-peek-unavailable');
    }, { once: true });
  })();
</script>

<style is:global>
  html.studio-peek,
  html.studio-peek body {
    width: 100%; height: 100%; min-width: 0 !important;
    margin: 0 !important; padding: 0 !important; overflow: hidden !important;
    background: #15243a !important;
  }
  html.studio-peek .v3-header,
  html.studio-peek .v3-skip,
  html.studio-peek .v3-footer,
  html.studio-peek .v3-object-title,
  html.studio-peek .v3-object-actions,
  html.studio-peek .v3-object-viewer-controls,
  html.studio-peek .stage-hint,
  html.studio-peek .immersive-tools,
  html.studio-peek [data-display-controls],
  html.studio-peek [data-spatial],
  html.studio-peek [data-spatial-unavailable],
  html.studio-peek .stage-tag,
  html.studio-peek .stage-corner {
    display: none !important;
  }
  html.studio-peek main { height: 100% !important; margin: 0 !important; padding: 0 !important; }
  html.studio-peek main > section:not(#sculpture) { display: none !important; }
  html.studio-peek #sculpture {
    height: 100% !important; min-height: 0 !important; padding: 0 !important;
    margin: 0 !important; overflow: hidden !important; background: #15243a !important;
  }
  html.studio-peek #sculpture > .viewer {
    height: 100% !important; width: 100% !important; display: block !important;
    margin: 0 !important; padding: 0 !important;
  }
  html.studio-peek #sculpture > .viewer .model-stage {
    height: 100% !important; min-height: 0 !important; width: 100% !important;
    background: #15243a !important;
  }
  html.studio-peek #sculpture [data-poster] {
    object-fit: contain !important; mask-image: none !important; -webkit-mask-image: none !important;
  }
  html.studio-peek #sculpture canvas { pointer-events: none !important; }
  html.studio-peek-unavailable body { visibility: hidden !important; }
</style>
