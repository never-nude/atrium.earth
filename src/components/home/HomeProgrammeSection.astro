---
import V3WorkCard from '../v3/V3WorkCard.astro';
import V3WingGrid from '../v3/V3WingGrid.astro';
import { exhibitionFeaturedWork, v3ExhibitionRoute, v3WorkRoute } from '../../lib/v3';
import { currentProgramme, type ProgrammeSection } from '../../lib/programme';
import { withBase } from '../../lib/urls';
import { arVrFeatured, arVrCount, arVrVerifiedCount } from '../../lib/spatial-catalog';
import spatialMuseum from '../../../public/spatial-museum/collection-manifest.json';

type Props = {
  section: ProgrammeSection;
  number: string;
};
const { section, number } = Astro.props;
const { focus, focusIntro, exhibitions, pairings, room: currentRoom } = currentProgramme;
const spatialRooms = spatialMuseum.rooms;
const spatialWings = (spatialMuseum as unknown as { wings?: { id: string; title: string; subtitle: string }[] }).wings || [];
---

{section === 'wings' && <section class="v3-section v3-section--line" aria-labelledby="wings-home-title" data-home-section="wings">
  <div class="v3-section-head v3-section-head--split">
    <div>
      <p class="v3-kicker">{number} / Museum wings</p>
      <h2 id="wings-home-title" class="v3-display">Browse by region and period.</h2>
    </div>
    <a href={withBase('/wings/')}>Explore all museum wings →</a>
  </div>
  <V3WingGrid compact={true} />
</section>}

{section === 'galleries' && <section class="v3-section studio-museum-entry" aria-labelledby="studio-museum-title" data-home-section="galleries" data-programme-room={currentRoom?.id}>
  <div class="studio-museum-entry__copy">
    <p class="v3-kicker">{number} / 3D galleries · {spatialWings.length} wings · {spatialRooms.length} rooms</p>
    <h2 id="studio-museum-title" class="v3-display">Explore the collection in 3D rooms.</h2>
    <p>Walk through themed galleries with {spatialMuseum.works} sculptures shown at documented or estimated sizes.</p>
  </div>
  <a class="v3-button v3-button--light studio-museum-entry__enter" href={withBase('/spatial-museum/')}>
    Enter the 3D galleries <span aria-hidden="true">↗</span>
  </a>
  <nav class="studio-museum-entry__rooms" aria-label="3D galleries and rooms">
    <div class="studio-museum-entry__wings">
      {spatialWings.map(wing => <a href={withBase(`/spatial-museum/?wing=${wing.id}`)}>{wing.title}<span aria-hidden="true"> ↗</span></a>)}
    </div>
    <ol>
      {spatialRooms.map((room, index) => (
        <li class:list={{ 'home-programme-room': room.id === currentRoom?.id }}>
          <a href={withBase(`/spatial-museum/?room=${room.id}`)}>
            <span class="studio-museum-entry__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span>{room.title}{room.id === currentRoom?.id && <small class="home-programme-room__label">This week</small>}</span>
            <span class="studio-museum-entry__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</section>}

{section === 'ar-vr' && <section class="v3-section v3-spatial-feature v3-section--line" aria-labelledby="spatial-feature-title" data-home-section="ar-vr">
  <div class="v3-section-head v3-section-head--split">
    <div>
      <p class="v3-kicker">{number} / AR / VR</p>
      <h2 id="spatial-feature-title" class="v3-display">See sculpture<br />in your space.</h2>
    </div>
    <a href={withBase('/ar-vr/')}>Explore {arVrCount} works <span aria-hidden="true">→</span></a>
  </div>
  <div class="v3-spatial-feature__intro">
    <p class="v3-editorial">Place a sculpture in your room with a compatible phone, or view it in a supported headset. Explore {arVrCount} models; {arVrVerifiedCount} have reviewed size references, including clearly labeled cast measurements.</p>
    <p class="v3-spatial-feature__note"><strong class="v3-dimension-status" data-dimension-status="verified">Verified dimensions</strong> use reviewed measurements. <strong class="v3-dimension-status" data-dimension-status="approximate">Approximate dimensions</strong> use the best available estimate. <strong class="v3-dimension-status" data-dimension-status="unknown">Dimensions unknown</strong> use an adjustable display size.</p>
  </div>
  <div class="v3-spatial-feature__works">
    {arVrFeatured.map((work) => <V3WorkCard work={work} displayTitle={work.slug === 'laocoon' ? 'Laocoön and His Sons' : undefined} spatial={true} />)}
  </div>
</section>}

{section === 'comparisons' && pairings.length > 0 && <section class="v3-section v3-section--line" aria-labelledby="pairs-title" data-home-section="comparisons">
  <div class="v3-section-head">
    <p class="v3-kicker">{number} / Comparisons</p>
    <h2 id="pairs-title" class="v3-display">Two works, considered together.</h2>
  </div>
  <div class="v3-pairs">
    {pairings.map((pair) => (
      <div class="v3-pair v3-reveal">
        <a class="v3-pair__img v3-float v3-float--soft" href={withBase(v3WorkRoute(pair.a))} aria-label={pair.a.title}>
          <img src={withBase(pair.a.thumbnailImage)} alt={pair.a.title} width="720" height="900" loading="lazy" decoding="async" />
        </a>
        <div class="v3-pair__copy">
          <p class="v3-kicker">{pair.title}</p>
          <p class="v3-wall">{pair.line}</p>
          <p class="v3-pair__works">
            <b>{pair.a.title}</b> · {pair.a.displayDate}<br />
            <b>{pair.b.title}</b> · {pair.b.displayDate}
          </p>
        </div>
        <a class="v3-pair__img v3-float v3-float--soft" href={withBase(v3WorkRoute(pair.b))} aria-label={pair.b.title}>
          <img src={withBase(pair.b.thumbnailImage)} alt={pair.b.title} width="720" height="900" loading="lazy" decoding="async" />
        </a>
      </div>
    ))}
  </div>
</section>}

{section === 'exhibitions' && <section class="v3-section v3-section--line" aria-labelledby="exhibitions-home-title" data-home-section="exhibitions" data-programme-focus={focus.slug}>
  <div class="v3-section-head v3-section-head--split">
    <div>
      <p class="v3-kicker">{number} / Exhibitions</p>
      <h2 id="exhibitions-home-title" class="v3-display">Guided ways through the collection.</h2>
    </div>
    <a href={withBase('/exhibitions/')}>All exhibitions →</a>
  </div>
  <div class="home-programme-focus">
    <p class="v3-kicker">This week</p>
    <p>{focusIntro}{' '}<a href={withBase(v3ExhibitionRoute(focus))}>{focus.title} <span aria-hidden="true">→</span></a></p>
  </div>
  <div class="v3-exlist">
    {exhibitions.map((exhibition) => (
      <a class:list={['v3-exrow', { 'home-programme-exrow--focus': exhibition.slug === focus.slug }]} href={withBase(v3ExhibitionRoute(exhibition))} style={`--ex-accent:${exhibition.accent}`}>
        <span class="v3-exrow__no">{exhibition.number}</span>
        <div>
          <p class="v3-exrow__kicker">{exhibition.kicker}</p>
          <h3>{exhibition.title}</h3>
        </div>
        <p class="v3-exrow__summary">{exhibition.summary}</p>
        <span class="v3-exrow__img v3-float"><img src={withBase(exhibitionFeaturedWork(exhibition).thumbnailImage)} alt="" width="240" height="300" loading="lazy" decoding="async" /></span>
        <b aria-hidden="true">↗</b>
      </a>
    ))}
  </div>
</section>}

<style>
  .home-programme-focus { margin: -8px 0 30px; padding: 4px 0 4px 16px; border-left: 2px solid var(--home-programme-accent, var(--v3-signal)); }
  .home-programme-focus .v3-kicker { margin: 0 0 7px; font-size: 10px; }
  .home-programme-focus > p:last-child { max-width: 75ch; margin: 0; color: var(--v3-muted); font-size: 13px; line-height: 1.7; }
  .home-programme-focus a { color: var(--v3-signal); text-underline-offset: 4px; }
  .home-programme-exrow--focus .v3-exrow__kicker::before { content: ''; display: inline-block; width: 16px; height: 2px; margin-right: 8px; background: var(--home-programme-accent, var(--v3-signal)); vertical-align: middle; }
  .home-programme-room { border-top-color: var(--home-programme-accent, var(--v3-signal)) !important; }
  .home-programme-room__label { display: block; margin-top: 3px; color: var(--v3-faint); font-size: 10px; font-weight: 400; }
</style>
