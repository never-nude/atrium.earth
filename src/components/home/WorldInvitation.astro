---
import { withBase } from '../../lib/urls';
import { worldCollection } from '../../lib/world-collection.ts';
import WorldViewControls from '../WorldViewControls.astro';
const counts = Object.fromEntries(worldCollection.places.map(place => [place.id,0]));
for (const work of worldCollection.works) if (work.placeId) counts[work.placeId]++;
const data = JSON.stringify({places:worldCollection.places,counts}).replace(/</g,'\\u003c');
---
<section id="explore-the-world" class="world-invitation" data-home-world aria-labelledby="world-invitation-title">
  <div class="world-invitation__copy">
    <p class="world-invitation__eyebrow">Place &amp; time / The collection</p>
    <h2 id="world-invitation-title">Art across<br />the world.</h2>
    <p class="world-invitation__lede">Explore sculpture by place and time. Follow a familiar landscape into an unfamiliar history.</p>
    <a href={withBase('/world/')}>Explore the globe <span aria-hidden="true">↗</span></a>
    <p class="world-invitation__note">Documented origins. Thousands of years of art.</p>
  </div>
  <div class="world-invitation__viewport" data-world-viewport>
    <div class="world-invitation__earth" data-home-world-globe data-land-url={withBase('/world/land.geo.json')}><p data-home-world-loading>Bringing Earth into view…</p></div>
    <WorldViewControls />
    <p class="world-invitation__hint">Drag to turn · Pinch or use + / − to zoom</p>
  </div>
  <script type="application/json" data-home-world-data set:html={data}></script>
</section>
<script>import '../../scripts/home-world.js';</script>
<style>
  .world-invitation { position:relative; isolation:isolate; display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); min-height:480px; margin:0 0 56px; overflow:hidden; color:#edf8ff; border:1px solid #48e6ff3d; background:radial-gradient(ellipse at 24% 65%,#102a3a88,transparent 58%),#050b15; }
  .world-invitation__copy { position:relative; z-index:1; padding:clamp(30px,4vw,60px) 0 clamp(30px,4vw,60px) clamp(28px,3.7vw,55px); align-self:center; }
  .world-invitation__eyebrow { margin:0 0 23px; color:#78dcef; font-size:9px; letter-spacing:.12em; text-transform:uppercase; }
  .world-invitation h2 { margin:0 0 24px; font-size:clamp(34px,4.6vw,68px); font-weight:500; letter-spacing:-.05em; line-height:1.02; }
  .world-invitation__lede { max-width:31ch; margin:0; color:#a7bdd0; font-size:14px; line-height:1.8; }
  .world-invitation__copy > a { display:inline-flex; align-items:center; gap:30px; min-height:44px; margin-top:25px; padding:11px 17px; color:#061520; background:#7ee7ef; border:1px solid #7ee7ef; border-radius:5px; text-decoration:none; font-size:12px; font-weight:600; }
  .world-invitation__copy > a:hover { background:#b6f8ff; }
  .world-invitation__note { margin:20px 0 0; color:#7d9aac; font-size:10px; line-height:1.7; }
  .world-invitation__viewport { display:flex; flex-direction:column; min-width:0; position:relative; background:radial-gradient(ellipse at 50% 48%,#0d244244,transparent 67%); }
  .world-invitation__earth { position:relative; min-width:0; min-height:400px; flex:1; height:clamp(390px,39vw,540px); }
  .world-invitation__earth > p { position:absolute; inset:45% 20px auto; margin:0; color:#86a8bc; text-align:center; font-size:11px; }
  .world-invitation__viewport :global(.world-view-controls) { border-top:0; background:transparent; }
  .world-invitation__hint { margin:0; padding:0 12px 17px; color:#789bad; font-size:10px; text-align:center; line-height:1.5; }
  .world-invitation__viewport:fullscreen { width:100%; height:100%; background:#040b16; }
  .world-invitation__viewport:fullscreen .world-invitation__earth { flex:1; height:auto; min-height:0; }
  @media(max-width:760px) { .world-invitation { grid-template-columns:1fr; margin-bottom:40px; } .world-invitation__copy { padding:30px 26px 0; } .world-invitation h2 { font-size:42px; } .world-invitation h2 br { display:none; } .world-invitation__lede { max-width:42ch; font-size:13px; } .world-invitation__copy > a { margin-top:20px; } .world-invitation__note { margin-top:13px; } .world-invitation__earth { height:380px; min-height:320px; } }
</style>
