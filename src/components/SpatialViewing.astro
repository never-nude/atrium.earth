---
import ArtworkLabel from './ArtworkLabel.astro';
type Props = { title: string; artworkLabel?: { title: string; period: string; region: string; maker: string; material: string }; artworkLabelUrl?: string; poster: string; reference?: { axis: string; meters: number; extentFraction?: number; estimated?: boolean } | null; sizeNote?: string; displaySupport?: { kind: string; height?: number; note: string } | null; verified?: boolean; referenceLabel?: string; defaultMaxExtentMeters?: number };
const { title, artworkLabel = { title, period: '', region: '', maker: '', material: '' }, artworkLabelUrl, poster, reference, sizeNote = 'Physical size is not yet calibrated. Display size is adjustable.', displaySupport, verified = false, referenceLabel, defaultMaxExtentMeters } = Astro.props;
const standHeight = displaySupport?.height && displaySupport.height > 0 ? displaySupport.height : 1;
const defaultSize = defaultMaxExtentMeters && defaultMaxExtentMeters < 1 ? `${Math.round(defaultMaxExtentMeters * 100)} cm` : `${defaultMaxExtentMeters || 1} m`;
---
<div id="ar-vr" class="spatial-viewing" data-spatial data-artwork-label-json={JSON.stringify(artworkLabel)} data-artwork-label-url={artworkLabelUrl} data-verified-reference={String(verified)} data-title={title} data-reference-axis={verified ? reference?.axis : undefined} data-reference-meters={verified ? reference?.meters : undefined} data-reference-extent-fraction={verified ? reference?.extentFraction : undefined} data-default-max-extent-meters={!verified ? defaultMaxExtentMeters || 1 : undefined} data-support-recommendation={displaySupport?.kind}>
  <button type="button" class="spatial-open" data-spatial-open aria-describedby={!verified ? 'spatial-default-warning' : undefined}>
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z M4 7.5l8 4.5 8-4.5 M12 12v9" /></svg>
    View in AR / VR
  </button>
  {!verified && <span id="spatial-default-warning" class="spatial-default-badge" data-spatial-default-warning>Size unverified · Starts at {defaultSize} on longest side</span>}
  <dialog class="spatial-dialog" data-spatial-dialog aria-label={`View ${title} in AR or VR`}>
    <div class="spatial-panel">
      <div class="spatial-top"><span>AR / VR · Beyond the screen</span><button type="button" data-spatial-close aria-label="Close AR and VR options" autofocus>✕</button></div>
      <h2>View in your space.</h2>
      <p class="spatial-intro">{title}</p>
      {referenceLabel && <p class:list={['spatial-reference-label', { 'spatial-size-unverified': !verified }]}>{!verified && <span aria-hidden="true">⚠ </span>}{referenceLabel}</p>}
      <p class:list={['spatial-size-note', { 'spatial-size-unverified': !verified }]} data-spatial-size-note>{sizeNote}</p>
      <div class="spatial-options">
        <section>
          <span class="spatial-number">01 / Augmented reality</span>
          <h3>In your room</h3>
          <p>Place the work on a floor or table and walk around it.</p>
          <button type="button" data-spatial-ar disabled>Checking your device…</button>
          <div class="spatial-quick-look-options" data-quick-look-options hidden>
            <button type="button" data-quick-look-prepare>Use Apple AR instead</button>
            <a data-quick-look rel="ar" download="artwork.usdz" aria-label="Open in Apple AR" hidden><img src={poster} alt="" />Open in Apple AR ↗</a>
            <p>Apple AR shows the sculpture without a label. Use its camera button, then return here to add the label to your saved photo.</p>
          </div>
          <p class="spatial-support" data-ar-support></p>
        </section>
        <section>
          <span class="spatial-number">02 / Virtual reality</span>
          <h3>Inside a headset</h3>
          <p>Explore the work from every side, at your own pace.</p>
          <button type="button" data-spatial-vr disabled>Checking your device…</button>
          <p class="spatial-support" data-vr-support></p>
        </section>
      </div>
      <p class="spatial-status" data-spatial-status role="status" aria-live="polite"></p>
      <button type="button" class="spatial-text-button" data-spatial-retry hidden>Retry loading sculpture ↻</button>
      <details class="spatial-photo" data-spatial-photo-panel>
        <summary>Add label to photo <span aria-hidden="true">+</span></summary>
        <div class="spatial-photo-content">
          <p data-spatial-photo-help>Choose a saved AR photo to add this work’s label. The photo stays on your device.</p>
          <button type="button" data-spatial-photo-choose>Choose photo</button>
          <input type="file" accept="image/*" data-spatial-photo-input hidden aria-label="Choose a saved AR photo" />
          <p data-spatial-photo-status role="status" aria-live="polite"></p>
          <div data-spatial-photo-result hidden>
            <img data-spatial-photo-preview alt={`Photo with the artwork label for ${title}`} />
            <div class="spatial-link-actions"><a data-spatial-photo-save download="atrium-artwork.jpg">Download photo</a><button type="button" data-spatial-photo-share hidden>Share / Save photo ↗</button></div>
          </div>
        </div>
      </details>
      <details class="spatial-display">
        <summary>Placement &amp; stand <span aria-hidden="true">+</span></summary>
        <div class="spatial-display-content">
          <label>Display support
            <select data-support-mode>
              <option value="auto">Recommended in VR</option>
              <option value="plinth">Use a virtual stand</option>
              <option value="surface">Use the floor or a real table</option>
            </select>
          </label>
          <label data-support-height-control>Stand height
            <input type="range" data-support-height min="0.2" max="1.4" step="0.05" value={standHeight} />
            <output data-support-height-value>{Math.round(standHeight * 100)} cm</output>
          </label>
          <p data-support-note>Small displayed pieces get a stand in VR. In AR, use a real table or choose a virtual stand.</p>
          {displaySupport?.note && <p data-display-recommendation>{displaySupport.note}</p>}
          <p>A stand raises the work without changing its size or proportions. Any base in the scan stays with the artwork.</p>
        </div>
      </details>
      <details class="spatial-handoff" data-spatial-handoff>
        <summary>Open on another device <span aria-hidden="true">↗</span></summary>
        <div class="spatial-handoff-content">
          <p data-device-help>Open this work in Safari on an iPhone or iPad, Chrome on an AR-capable Android phone, or your headset’s browser.</p>
          <label>Link to this work<input data-spatial-url type="url" readonly spellcheck="false" /></label>
          <div class="spatial-link-actions"><button type="button" data-spatial-copy>Copy link</button><button type="button" data-spatial-share>Share link ↗</button></div>
          <p data-spatial-link-status role="status" aria-live="polite"></p>
        </div>
      </details>
      <div class="spatial-footer"><button type="button" data-spatial-screen>Continue in 3D <span aria-hidden="true">↗</span></button><p>Rotate and zoom in this browser.</p></div>
    </div>
    <div class="spatial-overlay" data-spatial-overlay hidden>
      <div class="spatial-overlay-top"><button type="button" data-spatial-exit aria-label="Exit AR / VR" title="Exit AR / VR"><svg class="spatial-camera-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg><span class="spatial-camera-control-text">Exit AR / VR</span></button></div>
      <div class="spatial-overlay-bottom">
        <ArtworkLabel label={artworkLabel} />
        <div class="spatial-photo-actions">
          <button type="button" data-spatial-confirm-placement hidden disabled>Place work</button>
          <button type="button" data-spatial-photo-capture aria-label="Take photo" title="Take photo" hidden disabled><span class="spatial-camera-control-text">Take photo</span></button>
          <button type="button" data-spatial-photo-review aria-label="View photo" title="View photo" hidden><svg class="spatial-camera-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8" cy="8" r="1" /><path d="m3 17 5-5 4 4 4-6 5 7" /></svg><span class="spatial-camera-control-text">View photo ↗</span></button>
        </div>
        <p class="spatial-proposed-size" data-spatial-proposed-size hidden><span>Proposed H × W × D</span><output data-spatial-dimensions></output></p>
        <p class="spatial-capture-status" data-spatial-capture-status role="status" aria-live="polite"></p>
      <details class="spatial-overlay-controls">
        <summary aria-label="Move and resize work" title="Move and resize work"><svg class="spatial-camera-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h5m4 0h7M4 17h9m4 0h3" /><circle cx="11" cy="7" r="2" /><circle cx="15" cy="17" r="2" /></svg><span class="spatial-adjust-text">Move / size</span><span class="spatial-camera-control-text" aria-hidden="true">+</span></summary>
        <div class="spatial-placement-options">
        {!verified && <p class="spatial-size-unverified">Size unverified · Default {defaultSize} on longest side. Display size is adjustable.</p>}
        <p data-spatial-instructions role="status"></p>
        <label>Display size <input type="range" data-spatial-scale min="0.1" max="2" step="0.05" value="1" /><output data-spatial-size>100%</output></label>
        <p class="spatial-adjusted-size">H × W × D <output data-spatial-dimensions></output></p>
        <label data-spatial-support-control hidden>Stand height <input type="range" data-spatial-support-height min="0.2" max="1.4" step="0.05" value="1" /><output data-spatial-support-value>100 cm</output></label>
        <div><button type="button" data-spatial-place>Move work</button><button type="button" data-spatial-turn>Turn 30°</button><button type="button" data-spatial-reset-size>{verified ? 'Documented size' : 'Reset display size'}</button></div>
        </div>
      </details>
      </div>
    </div>
  </dialog>
</div>
<style>
  .spatial-viewing {
    --spatial-bg: var(--v3-void, #0e1626);
    --spatial-well: var(--v3-well, #172438);
    --spatial-ink: var(--v3-ink, #f7f5ef);
    --spatial-muted: var(--v3-muted, #c9c6bd);
    --spatial-line: var(--v3-line, rgba(247,245,239,.16));
    --spatial-accent: var(--v3-signal, #eccf7a);
    position: relative; z-index: 31; flex: 0 0 auto;
    font-family: var(--v3-sans, var(--ui, sans-serif));
  }
  button, a, input, select { font: inherit; }
  button, summary, a { -webkit-tap-highlight-color: transparent; }
  .spatial-open { display: inline-flex; align-items: center; gap: 9px; min-height: 44px; padding: 8px 0; border: 0; border-radius: 0; color: var(--spatial-ink); background: transparent; font-size: .7rem; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; white-space: nowrap; cursor: pointer; }
  .spatial-open:hover { color: var(--spatial-accent); }
  .spatial-default-badge { display: block; max-width: 29ch; color: #ffaaa3; font-size: 10px; line-height: 1.4; padding-bottom: 7px; }
  .spatial-size-unverified { color: #ffaaa3 !important; }
  .spatial-dialog { color-scheme: dark; width: min(740px, calc(100vw - 40px)); max-height: calc(100vh - 40px); max-height: calc(100dvh - 40px); padding: 0; margin: auto; border: 1px solid var(--spatial-line); border-radius: 4px; color: var(--spatial-ink); background: var(--spatial-bg); overflow: auto; overscroll-behavior: contain; }
  .spatial-dialog::backdrop { background: rgba(7,10,16,.82); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .spatial-panel { padding: 0 32px 24px; }
  .spatial-top { position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 66px; background: var(--spatial-bg); color: var(--spatial-muted); font-size: .63rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .spatial-top button { flex: none; width: 44px; height: 44px; margin-right: -10px; border: 0; background: transparent; color: var(--spatial-ink); cursor: pointer; font-size: 19px; }
  h2 { color: var(--spatial-ink); font: 400 clamp(30px, 5vw, 46px)/1.08 var(--v3-sans, var(--ui, sans-serif)); letter-spacing: -.04em; margin: 12px 0 16px; }
  .spatial-intro { margin: 0 0 8px; font-size: 17px; line-height: 1.5; }
  .spatial-size-note { margin: 0; color: var(--spatial-muted); font-size: 12px; line-height: 1.6; }
  .spatial-reference-label { margin: 0 0 8px; color: var(--spatial-accent); font-size: 12px; }
  .spatial-options { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 28px; margin: 28px 0 0; }
  .spatial-options section { border-top: 1px solid var(--spatial-line); padding-top: 18px; }
  .spatial-number { font-size: .6rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--spatial-accent); }
  h3 { color: var(--spatial-ink); font: 400 23px/1.2 var(--v3-sans, var(--ui, sans-serif)); letter-spacing: -.025em; margin: 12px 0; }
  .spatial-options p { font-size: 13px; line-height: 1.6; color: var(--spatial-muted); margin: 0 0 18px; }
  .spatial-options button, .spatial-options a, .spatial-link-actions button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 11px 16px; border: 1px solid var(--spatial-accent); border-radius: 3px; background: var(--spatial-accent); color: var(--spatial-bg); text-decoration: none; cursor: pointer; font-size: 12px; font-weight: 600; }
  .spatial-options button:disabled { background: var(--spatial-well); color: var(--spatial-muted); border-color: var(--spatial-line); cursor: wait; }
  .spatial-options button[data-handoff], .spatial-options [data-spatial-vr] { color: var(--spatial-ink); background: transparent; border-color: var(--v3-line-strong, #677080); }
  .spatial-options a img { width: 1px; height: 1px; position: absolute; opacity: 0; }
  .spatial-options section > p:not(.spatial-support) { min-height: 3.2em; }
  .spatial-options .spatial-support { font-size: 12px; margin: 12px 0 0; }
  .spatial-quick-look-options { margin-top: 12px; }
  .spatial-quick-look-options label { display: flex; align-items: center; gap: 10px; min-height: 44px; font-size: 12px; cursor: pointer; }
  .spatial-quick-look-options input { flex: none; width: 18px; height: 18px; margin: 0; accent-color: var(--spatial-accent); }
  .spatial-quick-look-options p { font-size: 12px; margin: 4px 0 0; }
  .spatial-status { font-size: 13px; line-height: 1.6; color: var(--spatial-accent); margin: 18px 0; }
  .spatial-status:empty { display: none; }
  details { border-top: 1px solid var(--spatial-line); }
  .spatial-display { margin-top: 26px; }
  summary { display: flex; align-items: center; justify-content: space-between; min-height: 54px; list-style: none; cursor: pointer; font-size: 13px; font-weight: 500; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--spatial-muted); }
  details[open] > summary span { transform: rotate(45deg); }
  .spatial-handoff[open] > summary span { transform: none; }
  .spatial-display-content, .spatial-handoff-content { padding: 0 0 20px; }
  .spatial-display label { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; font-size: 12px; }
  .spatial-display select, .spatial-handoff input { min-width: 0; min-height: 44px; padding: 8px 10px; border: 1px solid var(--v3-line-strong, #677080); border-radius: 3px; background: var(--spatial-well); color: var(--spatial-ink); font-size: 16px; }
  .spatial-display select { flex: 1; }
  input[type="range"] { accent-color: var(--spatial-accent); min-height: 32px; }
  .spatial-display input { flex: 1; min-width: 0; }
  output { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .spatial-display p, .spatial-handoff p { font-size: 12px; line-height: 1.6; color: var(--spatial-muted); margin: 8px 0 0; }
  .spatial-handoff label { display: grid; gap: 8px; margin: 16px 0 12px; font-size: 12px; }
  .spatial-handoff input { width: 100%; }
  .spatial-link-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .spatial-link-actions button { background: transparent; color: var(--spatial-ink); border-color: var(--v3-line-strong, #677080); }
  .spatial-footer { border-top: 1px solid var(--spatial-line); padding-top: 12px; display: flex; flex-wrap: wrap; gap: 4px 20px; align-items: center; }
  .spatial-footer button, .spatial-text-button { display: inline-flex; align-items: center; gap: 18px; min-height: 44px; padding: 8px 0; border: 0; background: transparent; color: var(--spatial-ink); cursor: pointer; font-size: 12px; }
  .spatial-footer p { margin: 0; font-size: 12px; color: var(--spatial-muted); }
  button:not(:disabled):hover, a:hover { filter: brightness(1.15); }
  button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 2px solid var(--spatial-accent); outline-offset: 3px; }
  [hidden] { display: none !important; }
  :global(body.spatial-modal-open) { overflow: hidden; }
  .spatial-overlay { position: fixed; inset: 0; color: var(--spatial-ink); pointer-events: none; }
  .spatial-overlay:fullscreen { background: transparent !important; }
  .spatial-overlay:xr-overlay { background: transparent !important; }
  .spatial-overlay-top { position: absolute; top: max(16px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); pointer-events: auto; }
  .spatial-overlay .spatial-overlay-top button { background: var(--v3-chrome-solid, #111a2cf7); }
  .spatial-overlay-bottom { position: absolute; left: max(16px, env(safe-area-inset-left)); bottom: max(16px, env(safe-area-inset-bottom)); width: min(340px, calc(100% - max(16px, env(safe-area-inset-left)) - max(16px, env(safe-area-inset-right)))); display: grid; gap: 8px; }
  .spatial-overlay-controls { padding: 0 14px; border: 1px solid var(--spatial-line); border-radius: 3px; background: var(--v3-chrome-solid, #111a2cf7); pointer-events: auto; }
  .spatial-overlay-controls summary { min-height: 44px; }
  .spatial-overlay-controls[open] > summary span:first-of-type { transform: none; }
  .spatial-placement-options { max-height: min(240px, 32dvh); overflow: auto; padding-bottom: 12px; }
  .spatial-placement-options > div { display: flex; flex-wrap: wrap; gap: 8px; }
  .spatial-overlay-controls p { font-size: 12px; line-height: 1.5; margin: 0 0 12px; }
  .spatial-photo-actions { display: flex; flex-wrap: wrap; gap: 8px; pointer-events: auto; }
  .spatial-photo-actions:has(> [hidden]:only-child), .spatial-photo-actions:not(:has(> :not([hidden]))) { display: none; }
  .spatial-photo-actions button { background: var(--v3-chrome-solid, #111a2cf7); font-size: 12px; }
  .spatial-photo-actions button[data-spatial-photo-capture] { background: var(--spatial-accent); color: var(--spatial-bg); border-color: var(--spatial-accent); }
  .spatial-photo-actions button:disabled { opacity: .55; cursor: wait; }
  .spatial-capture-status { margin: 0; padding: 8px 12px; color: var(--spatial-ink); background: var(--v3-chrome-solid, #111a2cf7); font-size: 12px; line-height: 1.4; }
  .spatial-capture-status:empty { display: none; }
  .spatial-photo-content { padding-bottom: 20px; }
  .spatial-photo-content p { margin: 0 0 12px; color: var(--spatial-muted); font-size: 12px; line-height: 1.5; }
  .spatial-photo-content button, .spatial-photo-content a { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 12px; border: 1px solid var(--spatial-line); border-radius: 3px; background: var(--spatial-well); color: var(--spatial-ink); font-size: 12px; text-decoration: none; cursor: pointer; }
  .spatial-photo-content [role="status"] { margin: 12px 0; }
  [data-spatial-photo-preview] { width: 100%; max-height: 50dvh; object-fit: contain; margin: 12px 0; }
  @media(orientation: landscape) and (max-height: 540px) {
    .spatial-overlay-bottom { width: min(340px, calc(100vw - 180px - env(safe-area-inset-left) - env(safe-area-inset-right))); max-height: calc(100dvh - max(16px, env(safe-area-inset-top)) - max(16px, env(safe-area-inset-bottom))); overflow-y: auto; pointer-events: auto; gap: 5px; }
    .spatial-overlay-bottom :global(.artwork-label) { padding: 10px 12px; }
    .spatial-overlay-bottom :global(.artwork-label-title) { font-size: 15px; }
    .spatial-photo-actions { position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); width: 140px; flex-direction: column; }
  }
  .spatial-overlay label { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; font-size: 12px; }
  .spatial-overlay input { flex: 1; min-width: 0; }
  .spatial-overlay button { min-height: 44px; padding: 8px 15px; border: 1px solid var(--spatial-line); border-radius: 3px; background: transparent; color: var(--spatial-ink); cursor: pointer; }
  .spatial-camera-icon { display: none; width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .spatial-quick-look-options [data-quick-look-prepare] { color: var(--spatial-muted); background: transparent; border-color: var(--spatial-line); }
  /* The browser camera and HUD live in a full-screen dialog, above page chrome.
     The label never participates in the model's 3D transforms or control stack. */
  .spatial-dialog.spatial-browser-ar { position: fixed; inset: 0; margin: 0; width: 100%; height: 100%; height: 100dvh; max-width: none; max-height: none; padding: 0; border: 0; border-radius: 0; overflow: hidden; background: #000; }
  .spatial-browser-ar .spatial-overlay { position: absolute; isolation: isolate; }
  .spatial-browser-ar .spatial-overlay-top { z-index: 3; top: auto; bottom: max(16px, env(safe-area-inset-bottom)); }
  .spatial-browser-ar :global([data-browser-ar-canvas]) { z-index: 0; }
  .spatial-browser-ar :global(.spatial-screen-label) { position: absolute; z-index: 1; bottom: calc(max(16px, env(safe-area-inset-bottom)) + 76px); left: max(16px, env(safe-area-inset-left)); width: min(240px, calc(100% - max(16px, env(safe-area-inset-left)) - max(16px, env(safe-area-inset-right)))); pointer-events: none; }
  .spatial-browser-ar .spatial-overlay-bottom { z-index: 2; inset: 0; width: auto; max-height: none; overflow: visible; display: block; pointer-events: none; }
  .spatial-browser-ar .spatial-overlay-bottom :global(.artwork-label) { display: none; }
  .spatial-browser-ar .spatial-camera-icon { display: block; }
  .spatial-browser-ar .spatial-camera-control-text { display: none; }
  .spatial-browser-ar .spatial-overlay-top button, .spatial-browser-ar [data-spatial-photo-review] { width: 44px; height: 44px; padding: 0; display: grid; place-items: center; border-radius: 50%; background: rgba(14,22,38,.45); }
  .spatial-browser-ar .spatial-photo-actions { display: contents; }
  .spatial-browser-ar .spatial-photo-actions button { position: absolute; bottom: max(16px, env(safe-area-inset-bottom)); pointer-events: auto; }
