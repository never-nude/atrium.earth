{
  "name": "atrium-earth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/prepare-browser-ar.mjs",
    "dev": "astro dev",
    "prebuild": "node ./scripts/prepare-browser-ar.mjs",
    "build": "astro build && node ./scripts/write-redirects.mjs && node ./scripts/prune-remote-assets.mjs",
    "test:wings": "node --experimental-strip-types ./scripts/test-wings.ts",
    "preview": "astro preview",
    "data:smk": "node ./scripts/enrich-smk.mjs",
    "verify:assets": "node ./scripts/verify-catalog-assets.mjs",
    "audit:orientation": "node ./scripts/audit-model-orientation.mjs",
    "images:posters": "node ./scripts/generate-posters.mjs",
    "images:renders": "node ./scripts/render-thumbnails.mjs",
    "images:mark-renders": "node ./scripts/mark-rendered-slugs.mjs",
    "models:preview": ".venv/bin/python ./scripts/generate-previews.py",
    "import:catalog:legacy": "node ./scripts/import-catalog.mjs",
    "ingest": "node ./scripts/ingest-manifests.mjs",
    "ingest:discover": "node ./scripts/discover-sources.mjs",
    "ingest:fetch": "node ./scripts/fetch-source.mjs",
    "ingest:assemble": "node ./scripts/assemble-piece.mjs",
    "ingest:auto": "npm run ingest:discover && npm run ingest:fetch && npm run ingest:assemble",
    "test:model-normalization": "node ./scripts/test-model-normalization.mjs",
    "test:spatial": "node ./scripts/test-spatial-capabilities.mjs && node ./scripts/test-spatial-viewer.mjs && node ./scripts/test-spatial-appearance.mjs",
    "test:spatial-label": "node ./scripts/test-spatial-artwork-label.mjs",
    "test:spatial-label-browser": "node ./scripts/test-spatial-label-browser.mjs",
    "test:spatial-eligibility": "node ./scripts/test-spatial-eligibility.mjs",
    "test:spatial-access": "node ./scripts/test-spatial-access.mjs",
    "test:display-support": "node ./scripts/test-display-support.mjs",
    "test:quick-look-export": "node ./scripts/test-quick-look-export.mjs",
    "test:dimensions": "node ./scripts/test-physical-dimensions.mjs",
    "test:browser-ar": "node scripts/test-browser-ar.mjs"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@gltf-transform/cli": "4.4.2",
    "astro": "^6.1.10",
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "@8thwall/engine-binary": "1.0.0",
    "@google/model-viewer": "^4.2.0",
    "lucide": "^1.14.0",
    "three": "^0.182.0"
  }
}
